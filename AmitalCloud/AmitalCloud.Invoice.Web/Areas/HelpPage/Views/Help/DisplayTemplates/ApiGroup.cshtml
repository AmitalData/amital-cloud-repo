@using AmitalCloud.Invoice.WebAPI.Areas.HelpPage
@using AmitalCloud.Invoice.WebAPI.Areas.HelpPage.Models
@using Microsoft.AspNetCore.Mvc.ApiExplorer
@using Microsoft.AspNetCore.Mvc.Controllers

@model IGrouping<ControllerActionDescriptor, ApiDescription>

@{
    var controllerDocumentation = ViewBag.DocumentationProvider != null ? 
        ViewBag.DocumentationProvider.GetDocumentation(Model.Key) : 
        null;
}

<h2 id="@Model.Key.ControllerName">@Model.Key.ControllerName</h2>
@if (!String.IsNullOrEmpty(controllerDocumentation))
{
    <p>@controllerDocumentation</p>
}
<table class="help-page-table">
    <thead>
        <tr><th>API</th><th>Description</th></tr>
    </thead>
    <tbody>
    @foreach (var api in Model)
    {
        <tr>
            <td class="api-name"><a href="@Url.Action("Api", "Help", new { apiId = api.GetFriendlyId() })">@api.HttpMethod @api.RelativePath</a></td>
            <td class="api-documentation">
            <!-- todo -->
            <p>No documentation available.</p>
            </td>
        </tr>
    }
    </tbody>
</table>