                                                                    Width="90"
                                                                    Height="25"
                                                                    Margin="3"
                                                                    Command="{Binding RemoveScreenFieldCol1Command}"
                                                                    CommandParameter="{Binding SelectedItem,
                                                                                               ElementName=QueriesListBox}"
                                                                    Content="Remove" />
                                                        </Grid>
                                                    </Border>

                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
