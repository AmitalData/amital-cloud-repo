                                                                       VerticalAlignment="Center"
                                                                       FontFamily="Lucida Sans Unicode"
                                                                       FontSize="14"
                                                                       Foreground="#FF6E7172"
                                                                       Text="{Binding ObjectFieldName}" />
                                                            <Button x:Name="btnRemoveScreenFieldCol1"
