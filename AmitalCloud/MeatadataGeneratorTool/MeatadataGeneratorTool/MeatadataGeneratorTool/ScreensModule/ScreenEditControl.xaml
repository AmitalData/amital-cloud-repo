<UserControl x:Class="MeatadataGeneratorTool.ScreensModule.ScreenEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:screen="clr-namespace:MeatadataGeneratorTool.ScreensModule"
             mc:Ignorable="d">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="TitleBackground" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#FFEAEAEB" />
            <GradientStop Offset="0.610443115234375" Color="sc#1, 0.7953632, 0.795877039, 0.804215252" />
            <GradientStop Offset="0.7698894739151001" Color="sc#1, 0.735742569, 0.7373737, 0.746481657" />
            <GradientStop Offset="0.87665826082229614" Color="sc#1, 0.6566499, 0.6597632, 0.6698923" />
            <GradientStop Offset="0.95973926782608032" Color="sc#1, 0.5620594, 0.5669453, 0.5782956" />
            <GradientStop Offset="1" Color="sc#1, 0.5028865, 0.50888133, 0.520995557" />
            <GradientStop Offset="1" Color="#FFBCBDBF" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Border Grid.Row="0"
            Margin="5,5,5,0"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="3 3 0 0"
            Visibility="{Binding ScreenDetailsVisibility,
                                 FallbackValue=Collapsed}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Height="25"
                        Background="{StaticResource TitleBackground}"
                        CornerRadius="3 3 0 0">
                    <TextBlock Margin="10 0 0 0"
                               VerticalAlignment="Center"
                               FontFamily="Lucida Sans Unicode"
                               FontSize="13"
                               Foreground="#FF282E30"
                               Text="Screen Details" />
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0"
                          Height="35"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="5"
                                   Text="Name" />
                        <TextBox Grid.Column="1"
                                 Width="227"
                                 Margin="5"
                                 HorizontalAlignment="Left"
                                 Text="{Binding Name}" />

                        <TextBlock Grid.Column="2"
                                   Margin="5"
                                   Text="Code" />
                        <TextBox Grid.Column="3"
                                 Width="227"
                                 Margin="5"
                                 HorizontalAlignment="Left"
                                 Text="{Binding Code}" IsEnabled="true"/>
                    </Grid>
                    <Grid Grid.Column="1"
                          Height="35"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="5"
                                   Text="Is Header Screen" />
                        <CheckBox Grid.Column="1"
                                  Height="25"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsHeaderScreen,
                                                      Mode=TwoWay}"
                                  IsEnabled="False" />
                    </Grid>
                    <Grid Grid.Column="2"
                          Height="35"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="5"
                                   Text="Is Read Only" />
                        <CheckBox Grid.Column="1"
                                  Height="25"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsReadOnly,
                                                      Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Grid.Column="3"
                                Margin="5"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="addColumnBtn"
                                Width="80"
                                Height="35"
                                Margin="5"
                                Command="{Binding AddColumnBtnCommand}"
                                Content="Add Column"
                                Visibility="{Binding AddColumnBtnVisibility,
                                                     FallbackValue=Collapsed}" />
                    </StackPanel>
                </Grid>

            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Visibility="{Binding Column1Visibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0"
                                    Margin="5"
                                    Orientation="Horizontal">
                            <Button x:Name="addBtn"
                                    Width="50"
                                    Margin="0 0 5 0"
                                    Command="{Binding AddScreenCol1FieldCommand}"
                                    Content="Add" />
                        </StackPanel>
                        <ListBox x:Name="Column1ListBox"
                                 Grid.Row="2"
                                 Margin="5,0,5,5"
                                 ItemsSource="{Binding ScreenFieldCol1ObsList}"
                                 SelectedIndex="0"
                                 SelectedItem="{Binding SelectedFieldCol1,
                                                        Mode=TwoWay}">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid MinWidth="25" Margin="3">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="MouseOver">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                   Storyboard.TargetName="ItemBorder"
                                                                                                   Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0">
                                                                            <DiscreteObjectKeyFrame.Value>
                                                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                    <GradientStop Offset="0" Color="White" />
                                                                                    <GradientStop Offset="1" Color="#FFBACEE3" />
                                                                                </LinearGradientBrush>
                                                                            </DiscreteObjectKeyFrame.Value>
                                                                        </DiscreteObjectKeyFrame>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                    <!--
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="#FF1782B8" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    -->
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Selected">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                   Storyboard.TargetName="ItemBorder"
                                                                                                   Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0">
                                                                            <DiscreteObjectKeyFrame.Value>
                                                                                <LinearGradientBrush StartPoint="0.5,1.619" EndPoint="0.5,-0.19">
                                                                                    <GradientStop Offset="0" Color="#FF1782B8" />
                                                                                    <GradientStop Offset="0.521087646484375" Color="sc#1, 0.07436104, 0.285719752, 0.5282723" />
                                                                                    <GradientStop Offset="0.71199202537536621" Color="sc#1, 0.212689176, 0.417107344, 0.6311929" />
                                                                                    <GradientStop Offset="0.8492809534072876" Color="sc#1, 0.395504266, 0.590749741, 0.767213345" />
                                                                                    <GradientStop Offset="0.960737943649292" Color="sc#1, 0.613748252, 0.7980435, 0.92959404" />
                                                                                    <GradientStop Offset="1" Color="sc#1, 0.708375752, 0.8879231, 1" />
                                                                                    <GradientStop Offset="1" Color="#FFDBF2FF" />
                                                                                </LinearGradientBrush>
                                                                            </DiscreteObjectKeyFrame.Value>
                                                                        </DiscreteObjectKeyFrame>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                    <!--
                                                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                                        </ObjectAnimationUsingKeyFrames>
                                                                    -->
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled" />
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <Border x:Name="ItemBorder"
                                                            BorderThickness="0"
                                                            CornerRadius="5">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
