<UserControl x:Class="MeatadataGeneratorTool.DataContractsModule.AddDataContractControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Margin="0 0 0 5"
                Background="#FFF7E3E3"
                BorderBrush="#FFDA6F6F"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ErrorsVisibility,
                                     FallbackValue=Collapsed}">
            <TextBlock Margin="10"
                       FontSize="12"
                       Foreground="#FFB02020"
                       Text="{Binding ErrorMessages}" />
        </Border>
        <Border Grid.Row="1" Margin="5">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Vertical">
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Data Contract Name :" />
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Vertical">
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Version :" />
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Vertical">
                        <TextBlock Height="25"
                            Margin="5"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Include Tenant 0 Data: "/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="3" Orientation="Vertical" Visibility="Collapsed">
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Computing Partner Name :" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0"  Orientation="Vertical">
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 IsEnabled="True"
                                 Text="{Binding DCName,
                                                Mode=TwoWay}" />

                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical">
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 IsEnabled="True"
                                 Text="{Binding DCVersion,
                                                Mode=TwoWay}" />

                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Vertical" >
                        <CheckBox 
                        Margin="5"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IncludeTenant0Data, Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Vertical" Visibility="Collapsed">
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 IsEnabled="True"
                                 Text="{Binding ComputingPartnerName,
                                                Mode=TwoWay}" />

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Command="{Binding CancelBtnCommand}"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding OkBtnCommand}"
                        Content="Ok" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
