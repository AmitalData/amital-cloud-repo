<UserControl x:Class="MeatadataGeneratorTool.QueryModule.TablesDataUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helper="clr-namespace:MeatadataGeneratorTool.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <helper:GridConverter x:Key="GridConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Margin="0 0 0 5"
                Background="#FFF7E3E3"
                BorderBrush="#FFDA6F6F"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ErrorsVisibility,
                                     FallbackValue=Collapsed}">
            <TextBlock Margin="10"
                       FontSize="12"
                       Foreground="#FFB02020"
                       Text="{Binding ErrorMessages}" />
        </Border>
        <Border Grid.Row="1"
                MinWidth="100"
                MinHeight="100"
                Margin="5"
                Tag="{Binding CLoseTableFields}"
                helper:Attached.BindableChild="{Binding Tag,
                                                        RelativeSource={RelativeSource Self},
                                                        Converter={StaticResource GridConverter}}" />

        <Border Grid.Row="2"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                       >
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Command="{Binding CancelBtnCommand}"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding OkBtnCommand}"
                        Content="Ok" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
