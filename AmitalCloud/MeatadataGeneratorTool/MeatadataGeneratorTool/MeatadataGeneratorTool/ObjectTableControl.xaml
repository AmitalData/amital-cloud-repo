                                            </StackPanel>
                                            <StackPanel Grid.Row="21" Orientation="Horizontal">
                                                <Image ToolTip="First parameter: The primary key of the table. Second key: The field that links to the related table. templete:param1,param2" Source="Resources/question_mark_icon.png" Height="16" />
                                                <TextBlock Margin="6" VerticalAlignment="Center" Text="Related Key:" FontWeight="{Binding IsLockFontWeight}"/>
                                            </StackPanel>
                                            
                                            <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding HasApiHelper, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding HasCustomFields, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding NoTS, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding NoDefaultFeatures, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsTabsHidden, Mode=TwoWay}" />
                                            <ComboBox  Grid.Row="5" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding CodeField, Mode=TwoWay}" SelectedValuePath="FieldName" />
                                            <ComboBox  Grid.Row="6" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding NameField, Mode=TwoWay}" SelectedValuePath="FieldName" />
                                            <CheckBox Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AllowedForComputingPartners, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsMetadataOnlyTable, Mode=TwoWay}" />
                                            <TextBox Grid.Row="9" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DBTableShortName, Mode=TwoWay}" />
                                            <ComboBox Grid.Row="10" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="Name" ItemsSource="{Binding DxmlDatabaseTypes}" SelectedValue="{Binding DxmlDatabaseTypeCode, Mode=TwoWay}" SelectedValuePath="Code" />
                                            <ComboBox Grid.Row="11" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="Name" ItemsSource="{Binding DxmlDatabaseSchemas}" SelectedValue="{Binding DxmlDatabaseSchemaCode, Mode=TwoWay}" SelectedValuePath="Code" />
                                            <CheckBox Grid.Row="12" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsBusinessUnitEnabled , Mode=TwoWay}" HorizontalAlignment="Right" Margin="0,7" Width="220" />
                                            <TextBox Grid.Row="13" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ParentObjectTableName, Mode=TwoWay}" TextChanged="TextBox_TextChanged" />
                                            <CheckBox Grid.Row="14" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AvailableInCustomization , Mode=TwoWay}" />
                                            <CheckBox Grid.Row="15" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding SupportSubEntity , Mode=TwoWay}" />
                                            <CheckBox Grid.Row="16" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding ApplyGenericCustomFields , Mode=TwoWay}" />
                                            <CheckBox Grid.Row="17" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AvailableInDocumentTypes , Mode=TwoWay}" />
                                            <CheckBox Grid.Row="18" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding IsLock, Mode=TwoWay}" />
                                            <TextBox Grid.Row="19" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding RelatedEntity, Mode=TwoWay}" />
                                            <TextBox Grid.Row="20" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ThisKey, Mode=TwoWay}" />
                                            <TextBox Grid.Row="21" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding RelatedKey, Mode=TwoWay}" />
                                            
                                        </Grid>

                                    </Grid>

                                    <!--<Grid Visibility="Collapsed">
                                        <Image x:Name="btnDeleteLook1"
                                               Grid.Row="5"
                                               Grid.Column="2"
                                               Height="23"
                                               Margin="2 0 0 0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="btnDeleteLook1_MouseLeftButtonDown"
                                               Source="Eraser-icon.png" />
                                        <Image x:Name="btnDeleteLook2"
                                               Grid.Row="6"
                                               Grid.Column="2"
                                               Height="23"
                                               Margin="2 0 0 0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="btnDeleteLook2_MouseLeftButtonDown"
                                               Source="Eraser-icon.png" />
                                    </Grid>-->

                                    <Grid Grid.Row="1" Margin="0 5 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="95*"/>
                                            <ColumnDefinition Width="1359*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   FontSize="14"
                                                   Text="Display on Look Up Fields:" Grid.ColumnSpan="2" />

                                        <StackPanel Grid.Row="1"
                                                    Margin="0 5"
                                                    Orientation="Horizontal" Grid.ColumnSpan="2">
                                            <TextBlock Margin="0 0 5 0" Text="Select field to be added to list below: " />

                                            <ComboBox x:Name="LookUpCombo"
                                                      Width="200"
                                                      Height="22"
                                                      Margin="0 0 10 0"
                                                      DisplayMemberPath="FieldName"
                                                      ItemsSource="{Binding ToBeDisplayOnLookUpList}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <cmd:EventToCommand Command="{Binding LookUpSelectionChanged}" CommandParameter="{Binding SelectedItem, ElementName=LookUpCombo}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </ComboBox>

                                            <Button Width="70"
                                                    Height="22"
                                                    Command="{Binding AddToListCommand}"
                                                    Content="Add to List" />

                                        </StackPanel>

                                        <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <DataGrid x:Name="dgLookupFields"
                                                      Grid.Row="0"
                                                      AutoGenerateColumns="False"
                                                      ItemsSource="{Binding DisplayLookUpFieldsList,
                                                                            Mode=TwoWay}">
                                                <DataGrid.Columns>

                                                    <DataGridTemplateColumn Width="150"
                                                                            CanUserSort="True"
                                                                            Header="Field Name"
                                                                            IsReadOnly="True"
                                                                            SortMemberPath="FieldName">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding FieldName}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTextColumn Binding="{Binding DisplayInLookUpIndex, Mode=TwoWay}" Header="Display In LookUp Index" />
                                                    <DataGridTextColumn Binding="{Binding DisplayInLookupColumnSize, Mode=TwoWay}" Header="Display InLookup Column Size" />
                                                    <DataGridCheckBoxColumn Binding="{Binding DisplayInSearchWindowList, Mode=TwoWay}" Header="Display In Search Window List" />
                                                    <DataGridTextColumn Binding="{Binding DisplayInSearchWindowListIndex, Mode=TwoWay}" Header="Search Window List Index" />

                                                    <DataGridTemplateColumn Width="150">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button x:Name="btnRemove"
                                                                        Width="75"
                                                                        Click="btnRemove_Click"
                                                                        Content="Remove" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>


                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!--
                                                <DataGrid x:Name="dgWindowFields" Grid.Row="1" ItemsSource="{Binding DisplayLookUpFieldsList}" AutoGenerateColumns="False">
                                                <DataGrid.Columns>
                                                
                                                <DataGridTemplateColumn Header="Field Name" Width="150" IsReadOnly="True" SortMemberPath="FieldName" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding FieldName}"/>
                                                </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                
                                                
                                                <DataGridTemplateColumn Header="Search Window List Index" Width="150" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                <TextBox VerticalAlignment="Center" HorizontalAlignment="Center" Width="140" Text="{Binding DisplayInSearchWindowListIndex, Mode=TwoWay}" />
                                                </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                </DataGrid.Columns>
                                                </DataGrid>
                                            -->


                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="0 5 0 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   FontSize="14"
                                                   Text="Display on Look Up Local Fields:" />

                                        <StackPanel Grid.Row="1"
                                                    Margin="0 5"
                                                    Orientation="Horizontal">
                                            <TextBlock Margin="0 0 5 0" Text="Select field to be added to list below: " />

                                            <ComboBox x:Name="LocalLookUpCombo"
                                                      Width="200"
                                                      Height="22"
                                                      Margin="0 0 10 0"
                                                      DisplayMemberPath="FieldName"
                                                      ItemsSource="{Binding ToBeDisplayOnLookUpLocalList}">
                                                <i:Interaction.Triggers>
                                                    <i:EventTrigger EventName="SelectionChanged">
                                                        <cmd:EventToCommand Command="{Binding LookUpLocalSelectionChanged}" CommandParameter="{Binding SelectedItem, ElementName=LocalLookUpCombo}" />
                                                    </i:EventTrigger>
                                                </i:Interaction.Triggers>
                                            </ComboBox>

                                            <Button Width="70"
                                                    Height="22"
                                                    Command="{Binding AddToLocalListCommand}"
                                                    Content="Add to local List" />

                                        </StackPanel>

                                        <Grid Grid.Row="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <DataGrid x:Name="dgLocalLookupFields"
                                                      Grid.Row="1"
                                                      AutoGenerateColumns="False"
                                                      ItemsSource="{Binding DisplayLocalLookUpFieldsList,
                                                                            Mode=TwoWay}">
                                                <DataGrid.Columns>

                                                    <DataGridTemplateColumn Width="150"
                                                                            CanUserSort="True"
                                                                            Header="Field Name"
                                                                            IsReadOnly="True"
                                                                            SortMemberPath="FieldName">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding FieldName}" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridTextColumn Binding="{Binding DisplayInLookUpIndex, Mode=TwoWay}" Header="Display In LookUp Index" />
                                                    <DataGridTextColumn Binding="{Binding DisplayInLookupColumnSize, Mode=TwoWay}" Header="Display InLookup Column Size" />
                                                    <DataGridCheckBoxColumn Binding="{Binding DisplayInSearchWindowList, Mode=TwoWay}" Header="Display In Search Window List" />
                                                    <DataGridTextColumn Binding="{Binding DisplayInSearchWindowListIndex, Mode=TwoWay}" Header="Search Window List Index" />

                                                    <DataGridTemplateColumn Width="150">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button x:Name="btnRemoveLocal"
                                                                        Width="75"
                                                                        Click="btnRemove_Click_Local"
                                                                        Content="Remove" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>


                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <!--
                                                <DataGrid x:Name="dgWindowFields" Grid.Row="1" ItemsSource="{Binding DisplayLookUpFieldsList}" AutoGenerateColumns="False">
                                                <DataGrid.Columns>
                                                
                                                <DataGridTemplateColumn Header="Field Name" Width="150" IsReadOnly="True" SortMemberPath="FieldName" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding FieldName}"/>
                                                </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                
                                                
                                                <DataGridTemplateColumn Header="Search Window List Index" Width="150" >
                                                <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                <TextBox VerticalAlignment="Center" HorizontalAlignment="Center" Width="140" Text="{Binding DisplayInSearchWindowListIndex, Mode=TwoWay}" />
                                                </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                
                                                </DataGrid.Columns>
                                                </DataGrid>
                                            -->


                                        </Grid>
                                    </Grid>

                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>

            <!--  Object Field  -->
            <TabItem Header="Object Field">
                <TabItem.Content>
                    <Border Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0 0 0 5"
                                        Orientation="Horizontal">
                                <Button x:Name="addBtn"
                                        Width="50"
                                        Margin="0 0 5 0"
                                        Command="{Binding AddFieldCommand}"
                                        Content="Add" />
                                <Button x:Name="removeBtn"
                                        Width="50"
                                        Command="{Binding RemoveFieldCommand}"
                                        CommandParameter="{Binding SelectedItem,
                                                                   ElementName=MyListBox}"
                                        Content="Remove" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="270" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBox x:Name="ObjectFieldsFilter"
                                             Grid.Row="0"
                                             Grid.Column="1"
                                             Height="22"
                                             VerticalAlignment="Center"
                                             Text="{Binding ObjectFieldsFilter,
                                                            Mode=TwoWay}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <cmd:EventToCommand Command="{Binding ObjectFieldsFilterTextChanged}" CommandParameter="{Binding Text, ElementName=ObjectFieldsFilter}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <ListBox x:Name="MyListBox"
                                             Grid.Row="1"
                                             ItemsSource="{Binding TempObsList}"
                                             SelectedIndex="0"
                                             SelectedItem="{Binding SelectedObjectField,
                                                                    Mode=TwoWay}">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Grid MinWidth="25" Margin="3">
                                                                <VisualStateManager.VisualStateGroups>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal" />
                                                                        <VisualState x:Name="MouseOver">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                               Storyboard.TargetName="ItemBorder"
                                                                                                               Storyboard.TargetProperty="Background">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                                                        <DiscreteObjectKeyFrame.Value>
                                                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                                <GradientStop Offset="0" Color="White" />
                                                                                                <GradientStop Offset="1" Color="#FFBACEE3" />
                                                                                            </LinearGradientBrush>
                                                                                        </DiscreteObjectKeyFrame.Value>
                                                                                    </DiscreteObjectKeyFrame>
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                                <!--
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="#FF1782B8" />
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                -->
                                                                            </Storyboard>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Selected">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                               Storyboard.TargetName="ItemBorder"
                                                                                                               Storyboard.TargetProperty="Background">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                                                        <DiscreteObjectKeyFrame.Value>
                                                                                            <LinearGradientBrush StartPoint="0.5,1.619" EndPoint="0.5,-0.19">
                                                                                                <GradientStop Offset="0" Color="#FF1782B8" />
                                                                                                <GradientStop Offset="0.521087646484375" Color="sc#1, 0.07436104, 0.285719752, 0.5282723" />
                                                                                                <GradientStop Offset="0.71199202537536621" Color="sc#1, 0.212689176, 0.417107344, 0.6311929" />
                                                                                                <GradientStop Offset="0.8492809534072876" Color="sc#1, 0.395504266, 0.590749741, 0.767213345" />
                                                                                                <GradientStop Offset="0.960737943649292" Color="sc#1, 0.613748252, 0.7980435, 0.92959404" />
                                                                                                <GradientStop Offset="1" Color="sc#1, 0.708375752, 0.8879231, 1" />
                                                                                                <GradientStop Offset="1" Color="#FFDBF2FF" />
                                                                                            </LinearGradientBrush>
                                                                                        </DiscreteObjectKeyFrame.Value>
                                                                                    </DiscreteObjectKeyFrame>
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                                <!--
                                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                                                    </ObjectAnimationUsingKeyFrames>
                                                                                -->
                                                                            </Storyboard>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Disabled" />
                                                                    </VisualStateGroup>
                                                                </VisualStateManager.VisualStateGroups>

                                                                <Border x:Name="ItemBorder"
                                                                        BorderThickness="0"
                                                                        CornerRadius="5">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                            <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                            <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <CheckBox x:Name="myCheckBox" VerticalAlignment="Center" IsChecked="{Binding IsChecked}" Margin="5,6,5,0" />
                                                                        <TextBlock x:Name="ItemContent"
                                                                               Margin="10 5 5 5"
                                                                               VerticalAlignment="Center"
                                                                               FontFamily="Lucida Sans Unicode"
                                                                               FontSize="14"
                                                                               Width="150"
                                                                               Foreground="#FF6E7172"
                                                                               Text="{Binding FieldName}" />
                                                                    </StackPanel>
                                                                </Border>

                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>

                                <ScrollViewer Grid.Column="1"
                                              Margin="-10 0 0 0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Grid Visibility="{Binding FieldsEditControlVisibility}">
                                        <local:ObjectFieldsControl DataContext="{Binding SelectedItem, ElementName=MyListBox, Mode=TwoWay}" />
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>

            <!--  Queries  -->
            <TabItem Header="Queries">
                <TabItem.Content>
                    <Border Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <ScrollViewer Grid.Row="1"
                      Margin="10 0 0 0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                        Grid.ColumnSpan="2"
                                        Height="25"
                                        Margin="5,5,5,0"
                                        Background="{StaticResource TitleBackground}"
                                        CornerRadius="3 3 0 0">
                                        <TextBlock Margin="10 0 0 0"
                                               VerticalAlignment="Center"
                                               FontFamily="Lucida Sans Unicode"
                                               FontSize="13"
                                               Foreground="#FF282E30"
                                               Text="Query Group" />
                                    </Border>
                                    <Grid Grid.Row="1" Margin="5,5,5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                                   Grid.Column="0"
                                                   Margin="5"
                                                   Text="Code" />
                                            <TextBox Grid.Row="0"
                                                 Grid.Column="1"
                                                 Width="227"
                                                 Margin="5"
                                                 HorizontalAlignment="Left"
                                                 IsEnabled="False"
                                                 Text="{Binding QueryGroupCode}" />
                                            <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Margin="5"
                                                   Text="Name" />
                                            <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Width="227"
                                                 Margin="5"
                                                 HorizontalAlignment="Left"
                                                 IsEnabled="False"
                                                 Text="{Binding QueryGroupName}" />
                                        </Grid>
                                        <Grid Grid.Column="1" />
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                        Margin="0,0,3,0"
                                        BorderBrush="LightGray"
                                        BorderThickness="1"
                                        CornerRadius="3 3 0 0">
                                        <Grid Grid.Column="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                Grid.ColumnSpan="2"
                                                Height="25"
                                                Background="{StaticResource TitleBackground}"
                                                CornerRadius="3 3 0 0">
                                                <TextBlock Margin="10 0 0 0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Lucida Sans Unicode"
                                                       FontSize="13"
                                                       Foreground="#FF282E30"
                                                       Text="Queries" />
                                            </Border>
                                            <Grid Grid.Row="1" Margin="5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="btnAddQuery"
                                                    Grid.Column="0"
                                                    Width="70"
                                                    Height="25"
                                                    Command="{Binding AddQueryCommand}"
                                                    CommandParameter="{Binding SelectedItem,
                                                                               ElementName=QueriesListBox}"
                                                    Content="Add Query" />
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">
                                                    <Button Name="moveUp"
                                                        Width="35"
                                                        Height="60"
                                                        Margin="3,3,3,3"
                                                        Command="{Binding MoveUpCommand}"
                                                        CommandParameter="{Binding SelectedItem,
                                                                                   ElementName=QueriesListBox}"
                                                        Content="Ç"
                                                        FontFamily="Wingdings 3" />
                                                    <Button Name="moveDown"
                                                        Width="35"
                                                        Height="60"
                                                        Margin="3,3,3,3"
                                                        Command="{Binding MoveDownCommand}"
                                                        CommandParameter="{Binding SelectedItem,
                                                                                   ElementName=QueriesListBox}"
                                                        Content="È"
                                                        FontFamily="Wingdings 3" />
                                                </StackPanel>
                                                <ListBox x:Name="QueriesListBox"
                                                     Grid.Column="0"
                                                     Margin="5,0,5,5"
                                                     ItemsSource="{Binding QueriesObsList}"
                                                     SelectedIndex="0"
                                                     SelectedItem="{Binding SelectedQuery,
                                                                            Mode=TwoWay}">

                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Grid MinWidth="25" Margin="3">
                                                                            <VisualStateManager.VisualStateGroups>
                                                                                <VisualStateGroup x:Name="CommonStates">
                                                                                    <VisualState x:Name="Normal" />
                                                                                    <VisualState x:Name="MouseOver">
                                                                                        <Storyboard>
                                                                                            <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                                       Storyboard.TargetName="ItemBorder"
                                                                                                                       Storyboard.TargetProperty="Background">
                                                                                                <DiscreteObjectKeyFrame KeyTime="0">
