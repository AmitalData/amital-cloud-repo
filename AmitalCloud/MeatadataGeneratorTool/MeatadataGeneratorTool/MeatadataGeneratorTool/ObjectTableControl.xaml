                                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="New Wizard Control Name" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Auto Complete Search Window:" />
