                                            <TextBox Grid.Row="10" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DependencyFilter2, Mode=TwoWay}" />
                                            <TextBox Grid.Row="11" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DependencyFilter3, Mode=TwoWay}" />
                                            <ComboBox Grid.Row="12" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding KeyPropertyPath, Mode=TwoWay}" SelectedValuePath="FieldName" />
                                            <ComboBox Grid.Row="13" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding SortingByObjectField, Mode=TwoWay}" SelectedValuePath="FieldName" />
                                            <ComboBox Grid.Row="14" Grid.Column="1" Height="22" VerticalAlignment="Center" SelectedValue="{Binding SortingByDirection, Mode=TwoWay}" SelectedValuePath="Content" >
                                                <ComboBoxItem Content="Ascending" IsSelected="True"/>
                                                <ComboBoxItem Content="Descending"/>
                                            </ComboBox>
                                            <TextBox Grid.Row="15" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ShortTitleControlPath, Mode=TwoWay}" />
                                            <TextBox Grid.Row="16" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding MainTipCode, Mode=TwoWay}" />
                                            <ComboBox Grid.Row="17" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="Name" ItemsSource="{Binding ObjectTableTypes}" SelectedValue="{Binding ObjectTableTypeCode, Mode=TwoWay}" SelectedValuePath="Code" />
                                            <TextBox Grid.Row="18" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding MaxNumberOfCustomFields, Mode=TwoWay}" />
                                            <TextBox Grid.Row="19" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ParentTableName, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="20" Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding DomainServiceVisibility}" IsChecked="{Binding GenerateDomainService, Mode=TwoWay}" />
                                            <TextBox Grid.Row="21" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DefaultText, Mode=TwoWay}" />
                                            <TextBox Grid.Row="22" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding LocalDefaultText, Mode=TwoWay}" />
                                            <TextBox Grid.Row="23" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding NewButtonDefaultText, Mode=TwoWay}" />
                                            <TextBox Grid.Row="24" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding NewButtonLocalDefaultText, Mode=TwoWay}" />
                                            <ComboBox Grid.Row="25" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding CloseTableCode, Mode=TwoWay}" SelectedValuePath="FieldName" Visibility="{Binding ClosedTablesFieldsVisibility}" />
                                            <ComboBox Grid.Row="26" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding CloseTableName, Mode=TwoWay}" SelectedValuePath="FieldName" Visibility="{Binding ClosedTablesFieldsVisibility}" />
                                            <CheckBox Grid.Row="27" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding HasShortTitle, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="28" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding HasHelper, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="29" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding HasFiltersMenu, Mode=TwoWay}" />
                                            <ComboBox x:Name="cmbDisplay" Grid.Row="30" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding LovDisplayMemberPath, Mode=TwoWay}" SelectedValuePath="FieldName" />
                                            <ComboBox x:Name="cmbDisplayLocal" Grid.Row="31" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding LovDisplayMemberPathLocal, Mode=TwoWay}" SelectedValuePath="FieldName" />

                                        </Grid>

                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition />
