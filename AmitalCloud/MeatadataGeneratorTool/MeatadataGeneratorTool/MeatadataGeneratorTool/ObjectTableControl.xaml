                                        Command="{Binding AddTableDataCommand}"
                                        Content="Add" />
                                <Button x:Name="editTableDataBtn"
                                        Width="50"
                                        Margin="0 0 5 0"
                                        Command="{Binding EditTableDataCommand}"
                                        Content="Edit" />
                                <Button x:Name="removeTableDataBtn"
                                        Width="50"
                                        Command="{Binding RemoveTableDataCommand}"
                                        Content="Remove" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Border Grid.Row="2"
                                        Background="LightBlue"
                                        Tag="{Binding CLoseTableDataGrid}"
