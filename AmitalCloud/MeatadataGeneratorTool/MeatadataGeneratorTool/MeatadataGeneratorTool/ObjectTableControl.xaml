                                                                            </Storyboard>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Disabled" />
                                                                    </VisualStateGroup>
                                                                </VisualStateManager.VisualStateGroups>

                                                                <Border x:Name="ItemBorder"
                                                                    BorderThickness="0"
                                                                    CornerRadius="5">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                            <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                            <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <TextBlock x:Name="ItemContent"
                                                                           Margin="10 5 5 5"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Lucida Sans Unicode"
                                                                           FontSize="14"
                                                                           Foreground="#FF6E7172"
                                                                           Text="{Binding Code}" />
                                                                </Border>

                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>

                                </Grid>



                                <Grid Grid.Column="4"
                                      Margin="5,0,5,0"
                                      Visibility="{Binding FeaturesEditControlVisibility}">
                                    <features:FeaturesControl DataContext="{Binding SelectedItem, ElementName=AdditionalFeaturesListBox, Mode=TwoWay}" />
                                </Grid>


                            </Grid>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>
        </TabControl>

        <!--  Buttons  -->
        <Border Grid.Row="2"
                Margin="10"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="generateBtn"
                        Width="150"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding GenerateBtnCommand}"
                        Content="Generate Create Table Sql" />
                <Button x:Name="generateRenameTableBtn"
                        Width="164"
                        Height="22"
                        Margin="5,0,0,0" Visibility="Collapsed"
                        Command="{Binding GenerateRenameTableBtnCommand}"
                        Content="Generate Rename Table Sql" />
                <Button x:Name="generateFieldsBtn"
                        Width="201"
                        Height="22"
                        Margin="5,0,0,0" 
                        Command="{Binding GenerateFieldsBtnCommand}"
                        Content="Generate Table Changes Sql" />
                <Button x:Name="generateUpdateFieldsBtn"
                        Width="201"
                        Height="22" Visibility="Collapsed"
                        Margin="5,0,0,0"
                        Command="{Binding GenerateUpdateFieldsBtnCommand}"
                        Content="Generate Alter Field Sql" />
                <Button x:Name="generateDeleteFieldsBtn"
                        Width="201"
                        Height="22" Visibility="Collapsed"
                        Margin="5,0,0,0"
                        Command="{Binding GenerateDeleteFieldsBtnCommand}"
                        Content="Generate Delete Selected Fields Sql" />
                <Button x:Name="generateRenameFieldsBtn"
                        Width="201"
                        Height="22" Visibility="Collapsed"
                        Margin="5,0,0,0"
                        Command="{Binding GenerateRenameFieldsBtnCommand}"
                        Content="Generate Rename Field Sql" />
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Click="cancelBtn_Click"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding OkBtnCommand}"
                        Content="Ok" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
