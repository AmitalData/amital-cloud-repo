                                            <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CacheOnClient, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding EditableFromAutoCompleteWindow, Mode=TwoWay}" />
                                            <CheckBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding HasCounter, Mode=TwoWay}" />
