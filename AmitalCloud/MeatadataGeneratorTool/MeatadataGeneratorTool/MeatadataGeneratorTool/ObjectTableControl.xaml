                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                                    <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                                    <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                            <TextBlock x:Name="ItemContent"
                                                                                                       Margin="10 5 5 5"
                                                                                                       HorizontalAlignment="Left"
                                                                                                       VerticalAlignment="Center"
                                                                                                       FontFamily="Lucida Sans Unicode"
                                                                                                       FontSize="14"
                                                                                                       Foreground="#FF6E7172"
                                                                                                       Text="{Binding FieldName}" />
                                                                        </Border>

                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Grid>


                                        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                            <Button Name="DCFieldmoveright"
                                                    Width="35"
                                                    Height="40"
                                                    Margin="3,3,3,3"
                                                    Command="{Binding DCFieldMoveRightCommand}"
                                                    CommandParameter="{Binding SelectedDBField,
                                                                               ElementName=DCFieldsListBox}"
                                                    Content="4"
                                                    FontFamily="Marlett"
                                                    FontSize="20" />
                                            <Button Name="DCFieldmoveLeft"
                                                    Width="35"
                                                    Height="40"
                                                    Margin="3,3,3,3"
                                                    Command="{Binding DCFieldMoveLeftCommand}"
                                                    CommandParameter="{Binding SelectedDataContract.SelectedDCField,
                                                                               ElementName=DBFieldsListBox}"
                                                    Content="3"
                                                    FontFamily="Marlett"
                                                    FontSize="20" />

                                        </StackPanel>
                                        <ListBox x:Name="DCFieldsListBox"
                                                                     Grid.Row="1"
                                                                     Grid.Column="2" 
                                                                     ItemsSource="{Binding SelectedDataContract.DCFieldsObsList}"
                                                                     SelectedIndex="0"
                                                                     SelectedItem="{Binding SelectedDataContract.SelectedDCField,
                                                                                            Mode=TwoWay}">

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Grid MinWidth="25" Margin="3">
                                                                    <VisualStateManager.VisualStateGroups>
                                                                        <VisualStateGroup x:Name="CommonStates">
                                                                            <VisualState x:Name="Normal" />
                                                                            <VisualState x:Name="MouseOver">
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                                                       Storyboard.TargetName="ItemBorder"
                                                                                                                                       Storyboard.TargetProperty="Background">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0">
                                                                                            <DiscreteObjectKeyFrame.Value>
                                                                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                                    <GradientStop Offset="0" Color="White" />
                                                                                                    <GradientStop Offset="1" Color="#FFBACEE3" />
                                                                                                </LinearGradientBrush>
                                                                                            </DiscreteObjectKeyFrame.Value>
                                                                                        </DiscreteObjectKeyFrame>
                                                                                    </ObjectAnimationUsingKeyFrames>

                                                                                </Storyboard>
                                                                            </VisualState>
                                                                            <VisualState x:Name="Selected">
                                                                                <Storyboard>
                                                                                    <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                                                       Storyboard.TargetName="ItemBorder"
                                                                                                                                       Storyboard.TargetProperty="Background">
                                                                                        <DiscreteObjectKeyFrame KeyTime="0">
                                                                                            <DiscreteObjectKeyFrame.Value>
                                                                                                <LinearGradientBrush StartPoint="0.5,1.619" EndPoint="0.5,-0.19">
                                                                                                    <GradientStop Offset="0" Color="#FF1782B8" />
                                                                                                    <GradientStop Offset="0.521087646484375" Color="sc#1, 0.07436104, 0.285719752, 0.5282723" />
                                                                                                    <GradientStop Offset="0.71199202537536621" Color="sc#1, 0.212689176, 0.417107344, 0.6311929" />
                                                                                                    <GradientStop Offset="0.8492809534072876" Color="sc#1, 0.395504266, 0.590749741, 0.767213345" />
                                                                                                    <GradientStop Offset="0.960737943649292" Color="sc#1, 0.613748252, 0.7980435, 0.92959404" />
                                                                                                    <GradientStop Offset="1" Color="sc#1, 0.708375752, 0.8879231, 1" />
                                                                                                    <GradientStop Offset="1" Color="#FFDBF2FF" />
                                                                                                </LinearGradientBrush>
                                                                                            </DiscreteObjectKeyFrame.Value>
                                                                                        </DiscreteObjectKeyFrame>
                                                                                    </ObjectAnimationUsingKeyFrames>

                                                                                </Storyboard>
                                                                            </VisualState>
                                                                            <VisualState x:Name="Disabled" />
                                                                        </VisualStateGroup>
                                                                    </VisualStateManager.VisualStateGroups>

                                                                    <Border x:Name="ItemBorder"
                                                                                                BorderThickness="0"
                                                                                                CornerRadius="5">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                                <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                                <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <TextBlock x:Name="ItemContent"
                                                                                                       Margin="10 5 5 5"
                                                                                                       HorizontalAlignment="Left"
                                                                                                       VerticalAlignment="Center"
                                                                                                       FontFamily="Lucida Sans Unicode"
                                                                                                       FontSize="14"
                                                                                                       Foreground="#FF6E7172"
                                                                                                       Text="{Binding DCFieldName}" />
                                                                    </Border>

                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <Grid Grid.Row="1"
                                                                  Grid.Column="3"
                                                                  Margin="5,0,5,0"
                                                                  Visibility="{Binding SelectedDataContract.DCFieldEditVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Field Name:" />
                                            <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Field Data Type:" />
                                            <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Needs Translation:" />
                                            <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Is Key:" />
                                            <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Height="22"
                                 Margin="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding SelectedDataContract.SelectedDCField.DCFieldName,
                                                Mode=TwoWay}" />
                                            <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Height="22"
                                 Margin="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding SelectedDataContract.SelectedDCField.FieldDataType,
                                                Mode=TwoWay}" />
                                            <TextBox Grid.Row="1"
                                 Grid.Column="2"
                                 Height="22"
                                 Margin="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding SelectedDataContract.SelectedDCField.DCVersion,
                                                Mode=TwoWay}" />
                                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsSpecialField,
                                                          Mode=TwoWay}" />
                                            <CheckBox Grid.Row="3" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsKey,
                                                          Mode=TwoWay}" />
                                            <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Mapped From:" />
                                            <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Height="22"
                                 Margin="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding SelectedDataContract.SelectedDCField.FieldName,
                                                Mode=TwoWay}" />
                                            <TextBlock Grid.Row="5"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Manual Mapping:" />
                                            <CheckBox Grid.Row="5" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsManualMapping,
                                                          Mode=TwoWay}" />
                                            <TextBlock Grid.Row="6"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Is Custom Type:" />
                                            <CheckBox Grid.Row="6" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsCustomType,
                                                          Mode=TwoWay}" />
                                            <TextBlock Grid.Row="7"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Is Attribute:" />
                                            <CheckBox Grid.Row="7" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsAttribute,
                                                          Mode=TwoWay}" />
                                            <TextBlock Grid.Row="8"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Ignore Custom Type Check:" />
                                            <CheckBox Grid.Row="8" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IgnoreCustomTypeCheck,
                                                          Mode=TwoWay}" />
                                            <TextBlock Grid.Row="9"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Field of Close Table:" />
                                            <TextBlock Grid.Row="10"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Is Composit Key:" />
                                            <CheckBox Grid.Row="9" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsCloseField,
                                                          Mode=TwoWay}" />
                                            <CheckBox Grid.Row="10" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsCompositKey,
                                                          Mode=TwoWay}" />
                                            <TextBlock Grid.Row="11"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Close Table Code:" />
                                            <TextBox Grid.Row="11"
                                 Grid.Column="1"
                                 Height="22"
                                 Margin="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding SelectedDataContract.SelectedDCField.CloseTableCode,
                                                Mode=TwoWay}" />
                                            <TextBlock Grid.Row="12"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Is Update Allowed:" />
                                            <CheckBox Grid.Row="12" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsUpdateAllowed,
                                                          Mode=TwoWay}" />
                                            <TextBlock Grid.Row="13"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Is Nullable:" />
                                            <CheckBox Grid.Row="13" Grid.Column="1"
                                      Margin="2"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding SelectedDataContract.SelectedDCField.IsNullable,
                                                          Mode=TwoWay}" />

                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>


            <TabItem Header="Additional Text Codes">
                <TabItem.Content>
                    <Border Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0 0 0 5"
                                        Orientation="Horizontal">
                                <Button  
                                        Width="50"
                                        Margin="0 0 5 0"
                                        Command="{Binding AddTextCodeCommand}"
                                        Content="Add" />
                                <Button 
                                        Width="50"
                                        Command="{Binding RemoveTextCodeCommand}"
                                        CommandParameter="{Binding SelectedItem,
                                                                   ElementName=AdditionalTextCodesListBox}"
                                        Content="Remove" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="19" />
                                    <ColumnDefinition Width="39" />
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30px"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="AdditionalTextCodesFilter"
                                             Grid.Row="0" 
                                             Height="22"
                                             VerticalAlignment="Center"
                                             Text="{Binding AdditionalTextCodesFilter,
                                                            Mode=TwoWay}" >
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="TextChanged">
                                                <cmd:EventToCommand Command="{Binding AdditionalTextCodesFilterTextChanged}" CommandParameter="{Binding Text, ElementName=AdditionalTextCodesFilter}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </TextBox>
                                    <ListBox x:Name="AdditionalTextCodesListBox"
