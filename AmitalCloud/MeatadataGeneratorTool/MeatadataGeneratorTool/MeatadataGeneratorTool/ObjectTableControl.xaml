                                                        </Grid>
                                                    </Grid>
                                                </Border>

                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>

            <!--  CLoseTables  -->
            <TabItem Header="Table's Data" Visibility="{Binding TablesDataVisibility, FallbackValue=Collapsed}">
