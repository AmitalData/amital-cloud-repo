                                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Object Table Singular:" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Object Table Plural:" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Client Module Name" />
                                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Server Module Name" />
                                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Description Default Text:" Margin="0,8,0,32" />
                                            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Description Local Default Text:" Margin="0,35,0,5" />
                                            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Text="Look Up 1:" />
                                            <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" Text="Look Up 2:" />
                                            <TextBlock Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" Text="Dependency Filter 1:" />
                                            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" Text="Dependency Filter 2:" />
                                            <TextBlock Grid.Row="11" Grid.Column="0" VerticalAlignment="Center" Text="Dependency Filter 3:" />
                                            <TextBlock Grid.Row="12" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Key Property Path:" />
                                            <TextBlock Grid.Row="13" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Sorting By Object Field:" />
                                            <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Bottom" FontWeight="Bold" Text="Sorting By Default Direction:" />
                                            <TextBlock Grid.Row="15" Grid.Column="0" VerticalAlignment="Center" Text="Short Title Control Path:" />
                                            <TextBlock Grid.Row="16" Grid.Column="0" VerticalAlignment="Center" Text="Main Tip:" />
                                            <TextBlock Grid.Row="17" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" Text="Object Table Type:" />
                                            <TextBlock Grid.Row="18" Grid.Column="0" VerticalAlignment="Center" Text="Max Number Of Custom Fields:" />
                                            <TextBlock Grid.Row="19" Grid.Column="0" VerticalAlignment="Center" Text="Parent Table Name:" />
