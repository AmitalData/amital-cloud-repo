                                            <ComboBox x:Name="cmbLook2" Grid.Row="8" Grid.Column="1" Height="22" VerticalAlignment="Center" DisplayMemberPath="FieldName" ItemsSource="{Binding ObsList}" SelectedValue="{Binding LookUp2, Mode=TwoWay}" SelectedValuePath="FieldName" />
