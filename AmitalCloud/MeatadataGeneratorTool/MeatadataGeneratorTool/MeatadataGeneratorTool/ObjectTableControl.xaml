                                            <TextBlock Grid.Row="22" Grid.Column="0" VerticalAlignment="Center" Text="Local Default Text" />
                                            <TextBlock Grid.Row="23" Grid.Column="0" VerticalAlignment="Center" Text="New Button Default Text" />
                                            <TextBlock Grid.Row="24" Grid.Column="0" VerticalAlignment="Center" Text="New Button Local Default Text" />
                                            <TextBlock Grid.Row="25" Grid.Column="0" VerticalAlignment="Center" Margin="0 4" Text="Close Table Code:" FontWeight="Bold" Visibility="{Binding ClosedTablesFieldsVisibility}" />
                                            <TextBlock Grid.Row="26" Grid.Column="0" VerticalAlignment="Center" Margin="0 4" Text="Close Table Name:" FontWeight="Bold" Visibility="{Binding ClosedTablesFieldsVisibility}" />
                                            <TextBlock Grid.Row="27" Grid.Column="0" VerticalAlignment="Center" Text="Has Short Title:" />
                                            <TextBlock Grid.Row="28" Grid.Column="0" VerticalAlignment="Center" Text="Has Helper:" />
                                            <TextBlock Grid.Row="29" Grid.Column="0" VerticalAlignment="Center" Text="Has Filters Menu:" />
                                            <TextBlock Grid.Row="30" Grid.Column="0" VerticalAlignment="Center" Text="Lov Display Member Path:" />
                                            <TextBlock Grid.Row="31" Grid.Column="0" VerticalAlignment="Center" Text="Lov Display Member Path Local:" />



                                            <TextBox Grid.Row="0" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ObjectTableName, Mode=TwoWay}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding DBTableName, Mode=TwoWay}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ObjectTableSingular, Mode=TwoWay}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ObjectTablePlural, Mode=TwoWay}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ClientModuleName,  Mode=TwoWay}" />
                                            <TextBox Grid.Row="5" Grid.Column="1" Height="22" VerticalAlignment="Center" Text="{Binding ServerModuleName, Mode=TwoWay}" />
