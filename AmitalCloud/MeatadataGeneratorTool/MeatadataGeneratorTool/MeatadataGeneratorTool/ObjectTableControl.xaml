                Margin="0 0 0 5"
                Background="#FFF7E3E3"
                BorderBrush="#FFDA6F6F"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ErrorsVisibility}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBlock Margin="10"
                           FontSize="12"
                           Foreground="#FFB02020"
                           Text="{Binding ErrorMessages}" />
            </ScrollViewer>
        </Border>

