<Window x:Class="MeatadataGeneratorTool.ObjectTableControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:events="clr-namespace:MeatadataGeneratorTool.EventTypes"
        xmlns:textcodes="clr-namespace:MeatadataGeneratorTool.TextCodes"
        xmlns:features="clr-namespace:MeatadataGeneratorTool.Features"
        xmlns:helper="clr-namespace:MeatadataGeneratorTool.Helpers"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:local="clr-namespace:MeatadataGeneratorTool"
        xmlns:menubuttons="clr-namespace:MeatadataGeneratorTool.MenuButtons"
        xmlns:query="clr-namespace:MeatadataGeneratorTool.QueryModule"
        xmlns:screen="clr-namespace:MeatadataGeneratorTool.ScreensModule"
        xmlns:tab="clr-namespace:MeatadataGeneratorTool.TabsModule" 
        xmlns:cmd="http://www.galasoft.ch/mvvmlight"
        Title="ObjectTableControl"
        Width="1500"
        Height="1300">

    <Window.Resources>
        <LinearGradientBrush x:Key="TitleBackground" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Offset="0" Color="#FFEAEAEB" />
            <GradientStop Offset="0.610443115234375" Color="sc#1, 0.7953632, 0.795877039, 0.804215252" />
            <GradientStop Offset="0.7698894739151001" Color="sc#1, 0.735742569, 0.7373737, 0.746481657" />
            <GradientStop Offset="0.87665826082229614" Color="sc#1, 0.6566499, 0.6597632, 0.6698923" />
            <GradientStop Offset="0.95973926782608032" Color="sc#1, 0.5620594, 0.5669453, 0.5782956" />
            <GradientStop Offset="1" Color="sc#1, 0.5028865, 0.50888133, 0.520995557" />
            <GradientStop Offset="1" Color="#FFBCBDBF" />
        </LinearGradientBrush>
        <helper:MyConverter x:Key="MyConverter" />
    </Window.Resources>

