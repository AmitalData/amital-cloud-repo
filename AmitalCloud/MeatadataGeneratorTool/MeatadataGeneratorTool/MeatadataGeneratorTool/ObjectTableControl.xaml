                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                           Storyboard.TargetName="ItemBorder"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                                    <DiscreteObjectKeyFrame.Value>
                                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                            <GradientStop Offset="0" Color="White" />
                                                                                            <GradientStop Offset="1" Color="#FFBACEE3" />
                                                                                        </LinearGradientBrush>
                                                                                    </DiscreteObjectKeyFrame.Value>
                                                                                </DiscreteObjectKeyFrame>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <!--
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF1782B8" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            -->
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Selected">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                           Storyboard.TargetName="ItemBorder"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                                    <DiscreteObjectKeyFrame.Value>
                                                                                        <LinearGradientBrush StartPoint="0.5,1.619" EndPoint="0.5,-0.19">
                                                                                            <GradientStop Offset="0" Color="#FF1782B8" />
                                                                                            <GradientStop Offset="0.521087646484375" Color="sc#1, 0.07436104, 0.285719752, 0.5282723" />
                                                                                            <GradientStop Offset="0.71199202537536621" Color="sc#1, 0.212689176, 0.417107344, 0.6311929" />
                                                                                            <GradientStop Offset="0.8492809534072876" Color="sc#1, 0.395504266, 0.590749741, 0.767213345" />
                                                                                            <GradientStop Offset="0.960737943649292" Color="sc#1, 0.613748252, 0.7980435, 0.92959404" />
                                                                                            <GradientStop Offset="1" Color="sc#1, 0.708375752, 0.8879231, 1" />
                                                                                            <GradientStop Offset="1" Color="#FFDBF2FF" />
                                                                                        </LinearGradientBrush>
                                                                                    </DiscreteObjectKeyFrame.Value>
                                                                                </DiscreteObjectKeyFrame>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <!--
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            -->
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Disabled" />
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>

                                                            <Border x:Name="ItemBorder"
                                                                    BorderThickness="0"
                                                                    CornerRadius="5">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                        <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                        <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <TextBlock x:Name="ItemContent"
                                                                           Margin="10 5 5 5"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Lucida Sans Unicode"
                                                                           FontSize="14"
                                                                           Foreground="#FF6E7172"
                                                                           Text="{Binding Name}" />
                                                            </Border>

                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>


                                <ScrollViewer Grid.Column="1"
                                              Margin="5,0,5,0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto">
                                    <Grid Visibility="{Binding ScreensEditControlVisibility}">
                                        <screen:ScreenEditControl DataContext="{Binding SelectedItem, ElementName=ScreenListBox, Mode=TwoWay}" />
                                    </Grid>
                                </ScrollViewer>

                            </Grid>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>

            <!--  Tabs  -->
            <TabItem Header="Tabs">
                <TabItem.Content>
                    <Border Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0 0 0 5"
                                        Orientation="Horizontal">
                                <Button x:Name="addTabBtn"
                                        Width="50"
                                        Margin="0 0 5 0"
                                        Command="{Binding AddTabCommand}"
                                        Content="Add" />
                                <Button x:Name="removeTabBtn"
                                        Width="50"
                                        Command="{Binding RemoveTabCommand}"
                                        CommandParameter="{Binding SelectedItem,
                                                                   ElementName=TabsListBox}"
                                        Content="Remove" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="19" />
                                    <ColumnDefinition Width="235" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid  Grid.Column="0" Grid.ColumnSpan="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ListBox x:Name="TabsListBox"
                                         Grid.Column="0"
                                         
                                         ItemsSource="{Binding TabsObsList}"
                                         SelectedIndex="0"
                                         SelectedItem="{Binding SelectedTab,
                                                                Mode=TwoWay}">

                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Grid MinWidth="25" Margin="3">
                                                                <VisualStateManager.VisualStateGroups>
                                                                    <VisualStateGroup x:Name="CommonStates">
                                                                        <VisualState x:Name="Normal" />
                                                                        <VisualState x:Name="MouseOver">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                           Storyboard.TargetName="ItemBorder"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                                                        <DiscreteObjectKeyFrame.Value>
                                                                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                                <GradientStop Offset="0" Color="White" />
                                                                                                <GradientStop Offset="1" Color="#FFBACEE3" />
                                                                                            </LinearGradientBrush>
                                                                                        </DiscreteObjectKeyFrame.Value>
                                                                                    </DiscreteObjectKeyFrame>
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                                <!--
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF1782B8" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            -->
                                                                            </Storyboard>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Selected">
                                                                            <Storyboard>
                                                                                <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                           Storyboard.TargetName="ItemBorder"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                                                        <DiscreteObjectKeyFrame.Value>
                                                                                            <LinearGradientBrush StartPoint="0.5,1.619" EndPoint="0.5,-0.19">
                                                                                                <GradientStop Offset="0" Color="#FF1782B8" />
                                                                                                <GradientStop Offset="0.521087646484375" Color="sc#1, 0.07436104, 0.285719752, 0.5282723" />
                                                                                                <GradientStop Offset="0.71199202537536621" Color="sc#1, 0.212689176, 0.417107344, 0.6311929" />
                                                                                                <GradientStop Offset="0.8492809534072876" Color="sc#1, 0.395504266, 0.590749741, 0.767213345" />
                                                                                                <GradientStop Offset="0.960737943649292" Color="sc#1, 0.613748252, 0.7980435, 0.92959404" />
                                                                                                <GradientStop Offset="1" Color="sc#1, 0.708375752, 0.8879231, 1" />
                                                                                                <GradientStop Offset="1" Color="#FFDBF2FF" />
                                                                                            </LinearGradientBrush>
                                                                                        </DiscreteObjectKeyFrame.Value>
                                                                                    </DiscreteObjectKeyFrame>
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                                <!--
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            -->
                                                                            </Storyboard>
                                                                        </VisualState>
                                                                        <VisualState x:Name="Disabled" />
                                                                    </VisualStateGroup>
                                                                </VisualStateManager.VisualStateGroups>

                                                                <Border x:Name="ItemBorder"
                                                                    BorderThickness="0"
                                                                    CornerRadius="5">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                            <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                            <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <TextBlock x:Name="ItemContent"
                                                                           Margin="10 5 5 5"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Lucida Sans Unicode"
                                                                           FontSize="14"
                                                                           Foreground="#FF6E7172"
                                                                           Text="{Binding Name}" />
                                                                </Border>

                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>

                                    <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">
                                        <Button  
                                                        Width="35"
                                                        Height="60"
                                                        Margin="3,3,3,3"
                                                        Command="{Binding MoveTabUpCommand}"
                                                        CommandParameter="{Binding SelectedItem,
                                                                                   ElementName=TabsListBox}"
                                                        Content="Ç"
                                                        FontFamily="Wingdings 3" />
                                        <Button  
                                                        Width="35"
                                                        Height="60"
                                                        Margin="3,3,3,3"
                                                        Command="{Binding MoveTabDownCommand}"
                                                        CommandParameter="{Binding SelectedItem,
                                                                                   ElementName=TabsListBox}"
                                                        Content="È"
                                                        FontFamily="Wingdings 3" />
                                    </StackPanel>
                                </Grid>


                                <Grid Grid.Column="3"
                                      Margin="5,0,5,0"
                                      Visibility="{Binding TabsEditControlVisibility}">
                                    <tab:TabsControl DataContext="{Binding SelectedItem, ElementName=TabsListBox, Mode=TwoWay}" />
                                </Grid>

                            </Grid>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>

            <!--  Event Types  -->
            <TabItem Header="Event Types">
                <TabItem.Content>
                    <Border Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0 0 0 5"
                                        Orientation="Horizontal">
                                <Button x:Name="addEventTypeBtn"
                                        Width="50"
                                        Margin="0 0 5 0"
                                        Command="{Binding AddEventTypeCommand}"
                                        Content="Add" />
                                <Button x:Name="removeEventTypeBtn"
                                        Width="50"
                                        Command="{Binding RemoveEventTypeCommand}"
                                        CommandParameter="{Binding SelectedItem,
                                                                   ElementName=EventTypesListBox}"
                                        Content="Remove" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="19" />
                                    <ColumnDefinition Width="235" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="EventTypesListBox"
                                         Grid.Column="0"
                                         Grid.ColumnSpan="3"
                                         ItemsSource="{Binding EventTypesObsList}"
                                         SelectedIndex="0"
                                         SelectedItem="{Binding SelectedEventType,
                                                                Mode=TwoWay}">

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Grid MinWidth="25" Margin="3">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal" />
                                                                    <VisualState x:Name="MouseOver">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                           Storyboard.TargetName="ItemBorder"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                                    <DiscreteObjectKeyFrame.Value>
                                                                                        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                            <GradientStop Offset="0" Color="White" />
                                                                                            <GradientStop Offset="1" Color="#FFBACEE3" />
                                                                                        </LinearGradientBrush>
                                                                                    </DiscreteObjectKeyFrame.Value>
                                                                                </DiscreteObjectKeyFrame>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <!--
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="#FF1782B8" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            -->
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Selected">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                           Storyboard.TargetName="ItemBorder"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0">
                                                                                    <DiscreteObjectKeyFrame.Value>
                                                                                        <LinearGradientBrush StartPoint="0.5,1.619" EndPoint="0.5,-0.19">
                                                                                            <GradientStop Offset="0" Color="#FF1782B8" />
                                                                                            <GradientStop Offset="0.521087646484375" Color="sc#1, 0.07436104, 0.285719752, 0.5282723" />
                                                                                            <GradientStop Offset="0.71199202537536621" Color="sc#1, 0.212689176, 0.417107344, 0.6311929" />
                                                                                            <GradientStop Offset="0.8492809534072876" Color="sc#1, 0.395504266, 0.590749741, 0.767213345" />
                                                                                            <GradientStop Offset="0.960737943649292" Color="sc#1, 0.613748252, 0.7980435, 0.92959404" />
                                                                                            <GradientStop Offset="1" Color="sc#1, 0.708375752, 0.8879231, 1" />
                                                                                            <GradientStop Offset="1" Color="#FFDBF2FF" />
                                                                                        </LinearGradientBrush>
                                                                                    </DiscreteObjectKeyFrame.Value>
                                                                                </DiscreteObjectKeyFrame>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                            <!--
                                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                                                </ObjectAnimationUsingKeyFrames>
                                                                            -->
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Disabled" />
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>

                                                            <Border x:Name="ItemBorder"
                                                                    BorderThickness="0"
                                                                    CornerRadius="5">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0.5,1.643" EndPoint="0.5,0.067">
                                                                        <GradientStop Offset="0" Color="#FFBCBDBF" />
                                                                        <GradientStop Offset="1" Color="#FFE6E7E8" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <TextBlock x:Name="ItemContent"
                                                                           Margin="10 5 5 5"
                                                                           HorizontalAlignment="Left"
                                                                           VerticalAlignment="Center"
                                                                           FontFamily="Lucida Sans Unicode"
                                                                           FontSize="14"
                                                                           Foreground="#FF6E7172"
                                                                           Text="{Binding EnglishName}" />
                                                            </Border>

                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>



                                <Grid Grid.Column="3"
                                      Margin="5,0,5,0"
                                      Visibility="{Binding EventTypesEditControlVisibility}">
                                    <events:EventTypesControl DataContext="{Binding SelectedItem, ElementName=EventTypesListBox, Mode=TwoWay}" />
                                </Grid>


                            </Grid>
                        </Grid>
                    </Border>
                </TabItem.Content>
            </TabItem>

            <!--  Menu Buttons  -->
            <TabItem Header="Menu Buttons">
                <TabItem.Content>
                    <Border Margin="5"
                            BorderBrush="Gray"
                            BorderThickness="1">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0 0 0 5"
                                    BorderBrush="LightGray"
                                    BorderThickness="1"
                                    CornerRadius="3 3 0 0">
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            Height="25"
                                            Background="{StaticResource TitleBackground}"
                                            CornerRadius="3 3 0 0">
                                        <TextBlock Margin="10,4,0,1"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Lucida Sans Unicode"
                                                   FontSize="13"
                                                   Foreground="#FF282E30"
                                                   Text="Menu Buttons Group" />
                                    </Border>
                                    <Grid Grid.Row="1" Margin="5,5,5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                                       Grid.Column="0"
                                                       Margin="5"
                                                       Text="Type" />
                                            <TextBox Grid.Row="0"
                                                     Grid.Column="1"
                                                     Width="227"
                                                     Margin="5"
                                                     HorizontalAlignment="Left"
                                                     IsEnabled="False"
                                                     Text="{Binding MenuButtonGroupType}" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.Column="0"
                                                       Margin="5"
                                                       Text="Name" />
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Width="227"
                                                     Margin="5"
                                                     HorizontalAlignment="Left"
                                                     IsEnabled="False"
                                                     Text="{Binding MenuButtonGroupName}" />
                                        </Grid>
                                        <Grid Grid.Column="1" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Margin="0 0 0 5"
                                    BorderBrush="LightGray"
                                    BorderThickness="1"
                                    CornerRadius="3 3 0 0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0"
                                            Grid.ColumnSpan="2"
                                            Height="25"
                                            Background="{StaticResource TitleBackground}"
                                            CornerRadius="3 3 0 0">
                                        <TextBlock Margin="10,4,0,1"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Lucida Sans Unicode"
                                                   FontSize="13"
                                                   Foreground="#FF282E30"
                                                   Text="Menu Buttons" />
                                    </Border>
                                    <Grid Grid.Row="1" Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0"
                                                    Margin="0 0 0 5"
                                                    Orientation="Horizontal">
                                            <Button x:Name="addMenuButtonBtn"
                                                    Width="50"
                                                    Margin="0 0 5 0"
                                                    Command="{Binding AddMenuButtonCommand}"
                                                    CommandParameter="Button"
                                                    Content="Add" />
                                            <Button x:Name="removeMenuButtonBtn"
                                                    Width="50"
                                                    Command="{Binding RemoveMenuButtonCommand}"
                                                    CommandParameter="{Binding SelectedItem,
                                                                               ElementName=MenuButtonsListBox}"
                                                    Content="Remove" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <Button Name="Column1moveLeft"
                                                    Width="35"
                                                    Height="40"
                                                    Margin="3,3,3,3"
                                                    Command="{Binding Col1MoveLeftCommand}"
                                                    CommandParameter="{Binding SelectedItem,
                                                                               ElementName=MenuButtonsListBox}"
                                                    Content="3"
                                                    FontFamily="Marlett"
                                                    FontSize="20" />
                                            <Button Name="Column1moveright"
                                                    Width="35"
                                                    Height="40"
                                                    Margin="3,3,3,3"
                                                    Command="{Binding Col1MoveRightCommand}"
                                                    CommandParameter="{Binding SelectedItem,
                                                                               ElementName=MenuButtonsListBox}"
                                                    Content="4"
                                                    FontFamily="Marlett"
                                                    FontSize="20" />


                                        </StackPanel>

                                        <Grid Grid.Row="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" MinHeight="45" />
                                                <RowDefinition Height="5" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <ListBox x:Name="MenuButtonsListBox"
                                                     Grid.Row="0"
                                                     Grid.ColumnSpan="3"
                                                     ItemsSource="{Binding MenuButtonsObsList}"
                                                     SelectedIndex="0"
                                                     SelectedItem="{Binding SelectedMenuButton,
                                                                            Mode=TwoWay}">

                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Grid MinWidth="25" Margin="3">
                                                                        <VisualStateManager.VisualStateGroups>
                                                                            <VisualStateGroup x:Name="CommonStates">
                                                                                <VisualState x:Name="Normal" />
                                                                                <VisualState x:Name="MouseOver">
                                                                                    <Storyboard>
                                                                                        <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                                       Storyboard.TargetName="ItemBorder"
                                                                                                                       Storyboard.TargetProperty="Background">
                                                                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                                                                <DiscreteObjectKeyFrame.Value>
                                                                                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                                                                        <GradientStop Offset="0" Color="White" />
                                                                                                        <GradientStop Offset="1" Color="#FFBACEE3" />
                                                                                                    </LinearGradientBrush>
                                                                                                </DiscreteObjectKeyFrame.Value>
                                                                                            </DiscreteObjectKeyFrame>
                                                                                        </ObjectAnimationUsingKeyFrames>
                                                                                        <!--
                                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemContent" Storyboard.TargetProperty="Foreground" Duration="0">
                                                                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#FF1782B8" />
                                                                                            </ObjectAnimationUsingKeyFrames>
                                                                                        -->
                                                                                    </Storyboard>
                                                                                </VisualState>
                                                                                <VisualState x:Name="Selected">
                                                                                    <Storyboard>
                                                                                        <ObjectAnimationUsingKeyFrames Duration="0"
                                                                                                                       Storyboard.TargetName="ItemBorder"
                                                                                                                       Storyboard.TargetProperty="Background">
                                                                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                                                                <DiscreteObjectKeyFrame.Value>
                                                                                                    <LinearGradientBrush StartPoint="0.5,1.619" EndPoint="0.5,-0.19">
                                                                                                        <GradientStop Offset="0" Color="#FF1782B8" />
                                                                                                        <GradientStop Offset="0.521087646484375" Color="sc#1, 0.07436104, 0.285719752, 0.5282723" />
                                                                                                        <GradientStop Offset="0.71199202537536621" Color="sc#1, 0.212689176, 0.417107344, 0.6311929" />
                                                                                                        <GradientStop Offset="0.8492809534072876" Color="sc#1, 0.395504266, 0.590749741, 0.767213345" />
                                                                                                        <GradientStop Offset="0.960737943649292" Color="sc#1, 0.613748252, 0.7980435, 0.92959404" />
                                                                                                        <GradientStop Offset="1" Color="sc#1, 0.708375752, 0.8879231, 1" />
                                                                                                        <GradientStop Offset="1" Color="#FFDBF2FF" />
