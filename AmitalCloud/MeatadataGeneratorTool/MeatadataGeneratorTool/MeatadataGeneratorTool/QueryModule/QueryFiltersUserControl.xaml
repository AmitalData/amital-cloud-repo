<UserControl x:Class="MeatadataGeneratorTool.QueryModule.QueryFiltersUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Margin="0 0 0 5"
                Background="#FFF7E3E3"
                BorderBrush="#FFDA6F6F"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ErrorsVisibility,
                                     FallbackValue=Collapsed}">
            <TextBlock Margin="10"
                       FontSize="12"
                       Foreground="#FFB02020"
                       Text="{Binding ErrorMessages}" />
        </Border>
        <Border Grid.Row="1" Margin="5">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Object Field :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Predefined Value :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Predefined Value2 :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Operator :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Index Order :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Custom Predefined :" />


                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Query :"
                                   Visibility="Hidden" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical">

                        <ComboBox Height="22"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="FieldName"
                                  ItemsSource="{Binding ObsList}"
                                  SelectedValue="{Binding ObjectFieldName,
                                                          Mode=TwoWay}"
                                  SelectedValuePath="FieldName" />

                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding PredefinedValue,
                                                Mode=TwoWay}" />

                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding PredefinedValue2,
                                                Mode=TwoWay}" />
                        <ComboBox Grid.Row="20"
                                  Grid.Column="1"
                                  Height="22"
                                  Margin="2"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding OperatorsList}"
                                  SelectedItem="{Binding Operator,
                                                         Mode=TwoWay}" />
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding IndexOrder,
                                                Mode=TwoWay}" />
                        <CheckBox 
                                Height="25"
                                Margin="5"
                                VerticalAlignment="Center"
                                IsChecked="{Binding CustomPredefined, Mode=TwoWay}"/>
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding QueryCode,
                                                Mode=TwoWay}"
                                 Visibility="Hidden" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="{Binding ButtonsVisibility,
                                             FallbackValue=Collapsed}">
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Command="{Binding CancelBtnCommand}"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding OkBtnCommand}"
                        Content="Ok" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
