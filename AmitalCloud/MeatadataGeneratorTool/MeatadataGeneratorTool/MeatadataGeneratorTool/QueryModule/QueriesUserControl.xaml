<UserControl x:Class="MeatadataGeneratorTool.QueryModule.QueriesUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Margin="0 0 0 5"
                Background="#FFF7E3E3"
                BorderBrush="#FFDA6F6F"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ErrorsVisibility,
                                     FallbackValue=Collapsed}">
            <TextBlock Margin="10"
                       FontSize="12"
                       Foreground="#FFB02020"
                       Text="{Binding ErrorMessages}" />
        </Border>
        <Border Grid.Row="1" Margin="5">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Code :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Text :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Local Text :" />

                        <TextBlock Height="25"
                                   Margin="5,5,0,5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Enable Add New Entity :" />
                        <TextBlock Width="111"
                                   Height="25"
                                   Margin="5,5,0,5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Is Packagable :" />
                        <TextBlock Width="111"
                                   Height="25"
                                   Margin="5,5,0,5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Default Sort Name :" />
                        <TextBlock Height="25"
                                   Margin="5,5,0,5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Default Sort Direction :" />

                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Edit Wizard Component Path:" />

                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Edit Wizard Name:" />
                      

                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Query Section :"
                                   Visibility="Visible" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Perspective:" />

                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Query Group Code :"
                                   Visibility="Hidden" />

                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Object Table Name :"
                                   Visibility="Hidden" />
                       
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding Code,
                                                Mode=TwoWay}" />
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding TextCode,
                                                Mode=TwoWay}" />
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding LocalTextCode,
                                                Mode=TwoWay}" />
                        <CheckBox Height="25"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsAddNewEntity,
                                                      Mode=TwoWay}" />
                        <CheckBox Height="25"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsPackagable,
                                                      Mode=TwoWay}" />
                        <ComboBox Height="22"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="FieldName"
                                  ItemsSource="{Binding ObsList}"
                                  SelectedValue="{Binding DefaultSortName,
                                                          Mode=TwoWay}"
                                  SelectedValuePath="FieldName" />

                        <ComboBox Height="22"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding SortDirections}"
                                  SelectedValue="{Binding DefaultSortDirection,
                                                          Mode=TwoWay}"
                                  SelectedValuePath="Name" />

                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding EditWizardComponentPath,
                                                Mode=TwoWay}" />
                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding EditWizardName,
                                                Mode=TwoWay}" />

                     


                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding QuerySection,
                                                Mode=TwoWay}"
                                 Visibility="Visible" />

                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding Perspective,
                                                Mode=TwoWay}" />

                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding QueryGroupCode,
                                                Mode=TwoWay}"
                                 Visibility="Hidden" />

                        <TextBox Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding ObjectTableName,
                                                Mode=TwoWay}"
                                 Visibility="Hidden" />
                       

                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="{Binding ButtonsVisibility,
                                             FallbackValue=Collapsed}">
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Command="{Binding CancelBtnCommand}"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding OkBtnCommand}"
                        Content="Ok" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
