<Window x:Class="MeatadataGeneratorTool.MainWindowControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
        xmlns:cmd="http://www.galasoft.ch/mvvmlight"
        Title="Main Window"
        Width="800"
        Height="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="345*" />
            <ColumnDefinition Width="26*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                MaxHeight="200"
                Margin="0 0 0 5"
                Background="#FFF7E3E3"
                BorderBrush="#FFDA6F6F"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ErrorsVisibility}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBlock Margin="10"
                           FontSize="12"
                           Foreground="#FFB02020"
                           Text="{Binding ErrorMessages}" />
            </ScrollViewer>
        </Border>
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="5"
                BorderBrush="Gray"
                BorderThickness="1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5"
                                Orientation="Vertical">
                        <TextBlock Margin="5"
                                   VerticalAlignment="Center"
                                   FontFamily="Lucida Sans Unicode"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FF282E30"
                                   Text="Object Table Name :" />
                        <TextBlock Margin="5"
                                   VerticalAlignment="Center"
                                   FontFamily="Lucida Sans Unicode"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#FF282E30"
                                   Text="Table Type :" />

                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Margin="5"
                                Orientation="Vertical">
                        <TextBox Width="200"
                                 Height="22"
                                 Margin="5"
                                 Text="{Binding ObjectTableName,
                                                Mode=TwoWay}" />
                        <ComboBox x:Name="TableTypes"
                                  Width="200"
                                  Height="22"
                                  Margin="5"
                                  DisplayMemberPath="TableTypeName"
                                  ItemsSource="{Binding TableTypesList}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <cmd:EventToCommand Command="{Binding TableTypesSelectionChanged}" CommandParameter="{Binding SelectedItem, ElementName=TableTypes}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Width="300"
                            Height="25"
                            Margin="5"
                            CornerRadius="3 3 0 0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Offset="0" Color="#FFEAEAEB" />
                                <GradientStop Offset="0.610443115234375" Color="sc#1, 0.7953632, 0.795877039, 0.804215252" />
                                <GradientStop Offset="0.7698894739151001" Color="sc#1, 0.735742569, 0.7373737, 0.746481657" />
                                <GradientStop Offset="0.87665826082229614" Color="sc#1, 0.6566499, 0.6597632, 0.6698923" />
                                <GradientStop Offset="0.95973926782608032" Color="sc#1, 0.5620594, 0.5669453, 0.5782956" />
                                <GradientStop Offset="1" Color="sc#1, 0.5028865, 0.50888133, 0.520995557" />
                                <GradientStop Offset="1" Color="#FFBCBDBF" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Margin="10 0 0 0"
                                   VerticalAlignment="Center"
                                   FontFamily="Lucida Sans Unicode"
                                   FontSize="13"
                                   Foreground="#FF282E30"
                                   Text="Suggested Object Fields" />
                    </Border>
                    <Grid Grid.Row="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Height="25"
                                       Margin="5"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Id :"
                                       Visibility="{Binding IdVisibility}" />
                            <TextBlock Height="25"
                                       Margin="5"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Tenant :"
                                       Visibility="{Binding TenantVisibility}" />
                            <TextBlock Width="140"
                                       Height="25"
                                       Margin="5,5,0,5"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Code :"
                                       Visibility="{Binding CodeVisibility}" />
                            <TextBlock Height="25"
                                       Margin="5"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Name :"
                                       Visibility="{Binding NameVisibility}" />
                            <TextBlock Height="25"
                                       Margin="5"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Create Date :"
                                       Visibility="{Binding CreateDateVisibility}" />
                            <TextBlock Height="25"
                                       Margin="5"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Created By User Id :"
                                       Visibility="{Binding CreatedByUserIdVisibility}" />
                            <TextBlock Height="25"
                                       Margin="5"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Update Date :"
                                       Visibility="{Binding UpdateDateVisibility}" />
                            <TextBlock Height="25"
                                       Margin="5"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Update By User Id :"
                                       Visibility="{Binding UpdateByUserIdVisibility}" />
                            <TextBlock
                                       Height="25"
                                       Margin="5,5,34,5"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="Search Fields :"
                                       Visibility="{Binding SearchFieldsStringVisibility}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical">
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsIdChecked,
                                                          Mode=TwoWay}"
                                      Visibility="{Binding IdVisibility}" />
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsTenantChecked,
                                                          Mode=TwoWay}"
                                      Visibility="{Binding TenantVisibility}" />
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsCodeChecked,
                                                          Mode=TwoWay}"
                                      Visibility="{Binding CodeVisibility}" />
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsNameChecked,
                                                          Mode=TwoWay}"
                                      Visibility="{Binding NameVisibility}" />
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsCreateDateChecked,
                                                          Mode=TwoWay}"
                                      Visibility="{Binding CreateDateVisibility}" />
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsCreatedByUserIdChecked,
                                                          Mode=TwoWay}"
                                      Visibility="{Binding CreatedByUserIdVisibility}" />
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsUpdateDateChecked,
                                                          Mode=TwoWay}"
                                      Visibility="{Binding UpdateDateVisibility}" />
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsUpdatedByUserIdChecked,
                                                          Mode=TwoWay}"
                                      Visibility="{Binding UpdateByUserIdVisibility}" />
                            <CheckBox Height="25"
                                      Margin="5"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSearchFieldsChecked,
                                                          Mode=TwoWay}"
                                      IsEnabled="{Binding IsSearchFieldsEnabled}"
                                      Visibility="{Binding SearchFieldsStringVisibility}" />
                        </StackPanel>
                    </Grid>
                </Grid>


            </Grid>
        </Border>
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Margin="10"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Click="cancelBtn_Click"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding OkBtnCommand}"
                        Content="Ok" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
