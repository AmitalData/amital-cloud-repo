<UserControl x:Class="MeatadataGeneratorTool.MenuButtons.MenuButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Margin="0 0 0 5"
                Background="#FFF7E3E3"
                BorderBrush="#FFDA6F6F"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding ErrorsVisibility,
                                     FallbackValue=Collapsed}">
            <TextBlock Margin="10"
                       FontSize="12"
                       Foreground="#FFB02020"
                       Text="{Binding ErrorMessages}" />
        </Border>
        <Border Grid.Row="1" Margin="5">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical">
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Event Code :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Default Text :" />
                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Local Default Text :" />

                        <TextBlock Height="25"
                                   Margin="5"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Menu Button Type :" />

                        <TextBlock Width="80"
                                   Height="25"
                                   Margin="5,5,0,5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Style :" />

                        <TextBlock Width="80"
                                   Height="25"
                                   Margin="5,5,0,5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="html Component Path :" />
                        <TextBlock Width="80"
                                   Height="25"
                                   Margin="5,5,0,5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Text="Width:" />

                        <TextBlock Width="80"
                                   Height="25"
                                   Margin="5,5,0,5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Text="Is Packagable :" />
                        

					</StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical">
                        <TextBox Width="200"
                                 Height="25"
                                 Margin="5"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding EventCode,
                                                Mode=TwoWay}" />
                        <TextBox Width="200"
                                 Height="25"
                                 Margin="5"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding DefaultText,
                                                Mode=TwoWay}" />

                        <TextBox Width="200"
                                 Height="25"
                                 Margin="5"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Text="{Binding LocalDefaultText,
                                                Mode=TwoWay}" />
                        <ComboBox Width="200"
                                  Height="22"
                                  Margin="5"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{Binding MenuButtonTypes}"
                                  SelectedValue="{Binding SelectedMenuButtonType,
                                                          Mode=TwoWay}"
                                  SelectedValuePath="Code" />


                        <TextBox Width="200"
                                 Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding Style,
                                                Mode=TwoWay}" />
                        <TextBox Width="200"
                                 Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding HtmlComponentPath,
                                                Mode=TwoWay}" />
                        <TextBox Width="200"
                                 Height="25"
                                 Margin="5"
                                 VerticalAlignment="Center"
                                 Text="{Binding Width,
                                                Mode=TwoWay}" />

                        <CheckBox Height="25"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsPackagable,
                                                      Mode=TwoWay}" />

					</StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2"
                Margin="5"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="{Binding ButtonsVisibility,
                                             FallbackValue=Collapsed}">
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Command="{Binding CancelBtnCommand}"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding OkBtnCommand}"
                        Content="Ok" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
