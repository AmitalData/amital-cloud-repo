                                 Text="{Binding HtmlListComponentUrl,
                                                Mode=TwoWay}" />
                        <TextBox Grid.Row="33"
                                 Grid.Column="1"
                                 Height="22"
                                 Margin="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding HtmlListComponentName,
                                                Mode=TwoWay}" />
                        <TextBox Grid.Row="35"
                                 Grid.Column="1"
                                 Height="22"
                                 Margin="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding DefaultValue,
                                                Mode=TwoWay}" />
                        <TextBox Grid.Row="36"
                                 Grid.Column="1"
                                 Height="22"
                                 Margin="2"
                                 VerticalAlignment="Center"
                                 Text="{Binding GeneratedComponentPath,
                                                Mode=TwoWay}" />


                    </Grid>

                </Grid>

            </Grid>
        </ScrollViewer>

        <!--  Buttons  -->
        <Border Grid.Row="2"
                Margin="0 10 0 0"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="0,0,8,8">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Visibility="{Binding ButtonsVisibility}">
                <Button x:Name="cancelBtn"
                        Width="57"
                        Height="22"
                        Command="{Binding CancelBtnCommand}"
                        Content="Cancel" />
                <Button x:Name="okBtn"
                        Width="57"
                        Height="22"
                        Margin="5,0,0,0"
                        Command="{Binding OkBtnCommand}"
                        Content="Ok" />
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
