using Logitude.BL.InfrastructureModel.EntityPMs;
using Logitude.BL.CommonDataModel.EntityPMs;
<#+}#>
<#+ if(entity.SupportSubEntity.ToString() == "true") {#>
using Logitude.BL.InfrastructureModel.EntityPMs;
<#+}#>
using <#= validatorsnamespace #>
  
namespace <#= pmnamespacestring #>
{
   [CustomValidation(typeof(<#= classlevelname #>), "ValidateClass")]
   [DataContract]
   public partial class <#=tableName #>PM : EntityPM
   {
   <#+
 	foreach(var field in entity["field"])  //get all classes
	 { 
		  if( field.HasPMField.GetType() == typeof(string))
           {
             if(field.HasPMField == "false")
               {
                  continue;
               }
           }
	bool isCustom= false;
	if(field.IsCustom.GetType() == typeof(string) && field.IsCustom == "true")
		{
			isCustom = true;
		}

		   string type = GetDataType(field);
		   if(type == "List")
           {
			    WritePMList(field);
           }
		   else
           {
				 if(!isCustom)
				{
					  WritePMProperty(field);
				}
				else
				{
					WritePMCustomFieldProperty(field);
				}
           }
	 }

	  if(entity.SupportSubEntity.ToString() == "true") {WriteSubEntityProperty();}

	 #>
	 <#+
	 if(entity.ApplyGenericCustomFields.ToString() == "true"){
		 int maxNumberOfCustomFields;
		 if(String.IsNullOrEmpty(entity.MaxNumberOfCustomFields)) maxNumberOfCustomFields = 0;
		 else maxNumberOfCustomFields = Int32.Parse(entity.MaxNumberOfCustomFields);
		 if(maxNumberOfCustomFields > 0){
			 for(int customFieldNumber = 1; customFieldNumber<=maxNumberOfCustomFields;customFieldNumber++){
				WriteGenericCustomFieldProperty(customFieldNumber);
			 }
		 }
	 }
	 #>
   }
   
}
	 <#+
    
  }

