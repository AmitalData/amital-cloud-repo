<#+

dynamic listservicenamespacestring;
 
string ListSrcFolder;
public void GenerateAllListServices(string sourceFolder,string destinationFolder,string modelname)
{
 ListSrcFolder = sourceFolder;
 listservicenamespacestring = GetListServiceNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string outputFilePath = Path.Combine(templateDirectory, sourceFolder);
foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateEntityListService(file,destinationFolder+"/"+fileNameWithoutExtension+"ListService.ts",modelname);
 
}

}
#>

<#+  

public void GenerateEntityListService(string xmlFilePath,string outputFilePath,string modelname)
{
	if(string.IsNullOrEmpty(listservicenamespacestring))
    {
		listservicenamespacestring = GetListServiceNameSpace(outputFilePath);
    }

        var entity = FromEntityListServiceFile(xmlFilePath);
        if( entity.IsComposition.GetType() == typeof(string))
      	{
	    	if(entity.IsComposition == "true")
	    	{
	    		return;
	    	}
	    } 

		 if( entity.NoViewController.GetType() == typeof(string))
      	{
	    	if(entity.NoViewController == "true")
	    	{
	    		return;
	    	}
	    } 
		 if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
          WriteEntityListServiceMethod(entity,modelname); 
          SaveEntityListServiceOutput(outputFilePath);
        

 }



#>

<#+

public dynamic GetListServiceNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Replace("JustWebFreight.","").Trim('.');

	return spacestring;
}

#>

<#+
void SaveEntityListServiceOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
     
	    var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>



<#+
 private void WriteEntityListServiceMethod(dynamic entity,string modelname)
{
    string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }

	string parententity = "object";
	string parentKeys = tableName + "Keys";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
		parententity = entity.ParentTableName +"PM";
		parentKeys =entity.ParentTableName + "Keys";
    }

    string listName = tableName + "List";
    
	string controllerName = tableName.ToLower()+"views";

   
	   string importentitytring = "import {"+listName+"} from '../../EntityLists/" + listName + "';";
	   //importentitytring += Environment.NewLine + BuildListImportEntitesString(entity);
	 
	  Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
	  string keysstring = "";
	   
	  bool hasTenant = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey.ToString() == "true")
				{ 
					 primaryKeys.Add(field.FieldName.Trim('"'),GetTSDataType(field));

				}
			}

			if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
			 
			}
		 }


		 string tenantParam ="";
		 string tenantonlyParam = "";
		 string tenantCondition = "";
		 string tenantKeyCondition = "";
		 string getalltenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = ", int tenant";
			 tenantonlyParam = ", tenant";
			 tenantCondition = "&& a.Tenant == tenant";
			 getalltenantCondition = "\n                   where a.Tenant == tenant";

		     tenantKeyCondition = "&& a.Tenant == keys.Tenant";
         }

		 string primarykeyParam="";
		 string primaryonlyparam = "";
		 string primarykeyCondition = "";
		 string primaryMethodParamText = "";
		// string keyprimarykeyCondition = "";
		int index = 0;
		 foreach(string key in primaryKeys.Keys)
         {
		   if(index > 0)
           {
			   primaryonlyparam += "+'&'+";
           }
			 primarykeyParam +=  key.ToLower() + ": " + primaryKeys[key]+ ", ";
			 primaryonlyparam +="'" +key.ToLower() + "=' + " + key.ToLower() ;
			 primarykeyCondition += " a." + key +" === "  + key.ToLower() +" &&";

		      primaryMethodParamText += key.ToLower() + ",";
			// keyprimarykeyCondition += " a." + key +" == a."  + key +" &&";



			index++;
         }
		 
		 primarykeyParam = primarykeyParam.TrimEnd(' ').TrimEnd(',');
		 primaryonlyparam = primaryonlyparam.TrimEnd(' ').TrimEnd('&');
		 primarykeyCondition = primarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');

		 primaryMethodParamText = primaryMethodParamText.TrimEnd(',').TrimEnd(',').Trim(' ');
		// keyprimarykeyCondition = keyprimarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');

		  string infrastructureImportString = "";
		 if(modelname != null && modelname.ToLower() == "infrastructure")
         {
			 infrastructureImportString += "import {ApiQueryFilters} from '../../DataContracts/ApiQueryFilters';";
			 infrastructureImportString += Environment.NewLine + "import {ServiceResponse} from '../../DataContracts/ServiceResponse';";
			 infrastructureImportString += Environment.NewLine + "import {InfraGenericFilter} from '../../Utilities/InfraGenericFilter';";
			 infrastructureImportString += Environment.NewLine + "import {CachedDataManager} from '../../Utilities/CachedDataManager';";
			 infrastructureImportString += Environment.NewLine + "import {ServiceHelper} from '../../Utilities/ServiceHelper';";
			 infrastructureImportString += Environment.NewLine + "import {SessionLocator} from '../../Utilities/SessionLocator';";
			 infrastructureImportString += Environment.NewLine + "import {SessionInfo} from '../../Utilities/SessionInfo';";
			 infrastructureImportString += Environment.NewLine + "import {LocalStorageManager} from '../../Utilities/LocalStorageManager';";
			 

			 infrastructureImportString += Environment.NewLine + "import {PerformanceLogger} from '../../Utilities/PerformanceLogger';";

         }
		 else{
			 infrastructureImportString += "import {ApiQueryFilters} from '../../../Infrastructure/DataContracts/ApiQueryFilters';";
			 infrastructureImportString += Environment.NewLine + "import {ServiceResponse} from '../../../Infrastructure/DataContracts/ServiceResponse';";
			 infrastructureImportString += Environment.NewLine + "import {InfraGenericFilter} from '../../../Infrastructure/Utilities/InfraGenericFilter';";
			 infrastructureImportString += Environment.NewLine + "import {CachedDataManager} from '../../../Infrastructure/Utilities/CachedDataManager';";
			 infrastructureImportString += Environment.NewLine + "import {ServiceHelper} from '../../../Infrastructure/Utilities/ServiceHelper';";
			 infrastructureImportString += Environment.NewLine + "import {SessionLocator} from '../../../Infrastructure/Utilities/SessionLocator';";
			 infrastructureImportString += Environment.NewLine + "import {SessionInfo} from '../../../Infrastructure/Utilities/SessionInfo';";	
			 infrastructureImportString += Environment.NewLine + "import {PerformanceLogger} from '../../../Infrastructure/Utilities/PerformanceLogger';";			 	
			 
			 infrastructureImportString += Environment.NewLine + "import {LocalStorageManager} from '../../../Infrastructure/Utilities/LocalStorageManager';";		
         }


    bool isClosed = false;
	if( entity.IsClosed.GetType() == typeof(string))
	{
	    isClosed = (entity.IsClosed == "true");
				 
    }

	bool hasCompactSearch = false;
	if( entity.HasCompactSearch.GetType() == typeof(string))
	{
	    hasCompactSearch = (entity.HasCompactSearch == "true");
				 
    }

	bool cacheOnClient = false;
	if( entity.CacheOnClient.GetType() == typeof(string))
	{
	    cacheOnClient = (entity.CacheOnClient == "true");
				 
    }


	bool hasCustomFilter = false;
	if( entity.HasCustomFilter.GetType() == typeof(string))
	{
	    hasCustomFilter = (entity.HasCustomFilter == "true");//'../../CustomFilters/UserCustomFilter'
					 
    }


	if(hasCustomFilter && cacheOnClient)
    {
			importentitytring  += Environment.NewLine + "import {"+tableName+"CustomFilter} from '../../CustomFilters/" + tableName + "CustomFilter';";

    }
#>
