<#+
private void GenerateInsideCompositionOnGetInitilization(dynamic field){

	string multitableName = GetFieldMultiTableName(field);
	//multitableName = GetObjectTableName(multitableName);
	string fieldName = field.FieldName.ToString().Trim('"');
	string pmname = multitableName + "PM";

	string parentpmname = GetFieldObjectTableName(field) + "PM";

	if(multitableName.ToLower() == "string")
               {
				   return;
               }

	string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
string xmlFilePath = Path.Combine(templateDirectory, SrcFolder) + "/"+multitableName + ".lxml";
if(Directory.Exists(xmlFilePath) || File.Exists(xmlFilePath))
  {
	  int gcount = 0;
	 var childEntity = FromEntityPMServiceFile(xmlFilePath);
	 foreach(var childEntityfield in childEntity["field"])  
	     { 
		  // string childEntityfieldName = childEntityfield.FieldName.ToString().Trim('"');
		   if( childEntityfield.HasPMField.GetType() == typeof(string))
           {
             if(childEntityfield.HasPMField == "false")
               {
                  continue;
               }
           }
		   string type = GetTSDataType(childEntityfield);
		   string childfieldName = childEntityfield.FieldName.ToString().Trim('"');
		   string childEntityPMName = GetFieldMultiTableName(childEntityfield) + "PM";
		   if(type == "List" || (childEntityfield.IsMulti.GetType() == typeof(string) && childEntityfield.IsMulti == "true"))
           { 
			   string childmultitableName = GetFieldMultiTableName(childEntityfield);
			   if(childmultitableName.ToLower() == "string")
               {
				   continue;
               }
			   if( childEntityfield.IsComposition.GetType() == typeof(string) && childEntityfield.IsComposition == "true")
                {
						gcount++;
#>
                new<#= pmname #>.<#= childfieldName #> = [];
                for (var k in my<#= pmname #>.<#= childfieldName #>) {
				    var my<#= childEntityPMName #> =my<#= pmname #>.<#= childfieldName #>[k];
				    var new<#= childEntityPMName #>=this.clone(my<#= pmname #>.<#= childfieldName #>[k]);
                    new<#= pmname #>.<#= childfieldName #>.push(new<#= childEntityPMName #>);

					 <#+  
					    this.GenerateInsideCompositionOnGetInitilization(childEntityfield);
					 #>
                }
<#+
					 
				}
		    }
         }

  }
 
}

    List<string> AddeMappingFunctions = new  List<string>();
private void GenerateCompositionFieldMap(dynamic entity,dynamic field,bool insideComposition = false){
			
	string multitableName = GetFieldMultiTableName(field);
	 	
	string fieldName = field.FieldName.ToString().Trim('"');
	string pmname = multitableName + "PM";
	bool hasCompstionCustomField = false;
	int numberOfCustomFields = entity.HasCustomFields.ToString() == "true" && !String.IsNullOrEmpty(entity.MaxNumberOfCustomFields.ToString()) ? Int32.Parse(entity.MaxNumberOfCustomFields.ToString()) + 1 : 51;

		string templateDirectory2 = Path.GetDirectoryName(Host.TemplateFile);
       string xmlFilePath2 = Path.Combine(templateDirectory2, SrcFolder) + "/"+multitableName + ".lxml";
        if(Directory.Exists(xmlFilePath2) || File.Exists(xmlFilePath2))
         {
	       var childEntity = FromEntityPMServiceFile(xmlFilePath2);
		   if(childEntity.AllowCustomFields.GetType() == typeof(string)  && childEntity.AllowCustomFields == "true" && childEntity.IsComposition.GetType() == typeof(string)  && childEntity.IsComposition == "true")
             {
	                     hasCompstionCustomField = true;
              }
 
	 }


	
	string parentpmname = GetFieldObjectTableName(field) + "PM";

	if(multitableName.ToLower() == "string")
               {
				   return;
               }

        string newMapMethod= fieldName + parentpmname;
        if(AddeMappingFunctions.Contains(newMapMethod))
            return;
        else
            AddeMappingFunctions.Add(newMapMethod);
