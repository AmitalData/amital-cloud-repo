<#+
private void GenerateNonCompositionFieldMap(dynamic entity,dynamic field){
	
	string fieldName = field.FieldName.ToString().Trim('"');
	string pmname = GetFieldMultiTableName(field) + "PM";
	string multitableName = GetFieldMultiTableName(field);
	string parentpmname = GetFieldObjectTableName(field) + "PM";

	if(multitableName.ToLower() == "string")
               {
				   return;
               }

         string newMapMethod= fieldName + parentpmname;
        if(AddeMappingFunctions.Contains(newMapMethod))
            return;
        else
            AddeMappingFunctions.Add(newMapMethod);
#>
    Map<#= fieldName #>(entityPM: <#= parentpmname #>, jsonPM: any, mapParent: boolean = true) {

        entityPM.<#= fieldName #> = new Array<<#= pmname #>>();
        for (var item in jsonPM.<#= fieldName #>) {

            var jItem = jsonPM.<#= fieldName #>[item];
            if (mapParent && (jItem.ChangeSetOp == "Delete" || jItem.ChangeSetOp == 3)) {
                continue;
            }
            var new<#= pmname #>: <#= pmname #>;
            new<#= pmname #> = new <#= pmname #>();
		    new<#= pmname #>.DisableMarkAsDirty = true;                
            var pmKeysArray = Object.keys(jItem);
            for (var pmKey in pmKeysArray) {
			
                if ((!mapParent && pmKeysArray[pmKey] === "entityParentPM" )|| pmKeysArray[pmKey] === "UIProperties" || pmKeysArray[pmKey] === "PropertyChanged") {
                    continue;
                }
                var pmProperty = pmKeysArray[pmKey];
                new<#= pmname #>[pmProperty] = jItem[pmProperty];
            }
			new<#= pmname #>.DisableMarkAsDirty = false;
            new<#= pmname #>.IsDirty = false;
            entityPM.<#= fieldName #>.push(new<#= pmname #>);
        }
    }
<#+
}
