<#+  

public void GenerateEntityPMService(string xmlFilePath,string outputFilePath,string modelname)
{
	if(string.IsNullOrEmpty(pmnamespacestringts))
    {
		pmnamespacestringts = GetPMServiceNameSpace(outputFilePath);
    }

        var entity = FromEntityPMServiceFile(xmlFilePath);
        if( entity.IsComposition.GetType() == typeof(string))
      	{
	    	if(entity.IsComposition == "true")
	    	{
	    		return;
	    	}
	    } 

		 if( entity.NoPMController.GetType() == typeof(string))
      	{
	    	if(entity.NoPMController == "true")
	    	{
	    		return;
	    	}
	    } 

		 if( entity.IsClosed.GetType() == typeof(string))
      	{
	    	if(entity.IsClosed == "true" && entity.ObjectTableName.Trim('"') != "PortTimeZone")
	    	{
	    		return;
	    	}
	    } 

          if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
		
          WriteEntityPMServiceMethod(entity,modelname); 
          SaveEntityPMServiceOutput(outputFilePath);
        

 }



#>

<#+

public dynamic GetPMServiceNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Replace("JustWebFreight.","").Trim('.');

	return spacestring;
}

#>

<#+
void SaveEntityPMServiceOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
     
	    var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>



<#+
 private void WriteEntityPMServiceMethod(dynamic entity,string modelname)
{
    string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');

	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }

	bool isComposition = false;
	if( entity.IsComposition.GetType() == typeof(string))
	{
	    isComposition = (entity.IsComposition == "true");
				 
    }

	bool isClosed = false;
	if( entity.IsClosed.GetType() == typeof(string))
	{
	    isClosed = (entity.IsClosed == "true");
				 
    }
	 
	
	bool applyDefaultValues = false;
	if( entity.ApplyDefaultValues.GetType() == typeof(string))
	{
	    applyDefaultValues = (entity.ApplyDefaultValues == "true");
				 
    }
	bool hasCustomValidator = false;
	if( entity.HasCustomValidator.GetType() == typeof(string))
	{
	    hasCustomValidator = (entity.HasCustomValidator == "true");
				 
    }	 

	string parententity = "object";
	string parentKeys = tableName + "Keys";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
		parententity = entity.ParentTableName +"PM";
		parentKeys =entity.ParentTableName + "Keys";
    }

    string listName = tableName + "List";
    string pmName = tableName + "PM";
	string controllerName = dBTableName.ToLower();
    int maxNumberOfCustomFields = entity.HasCustomFields.ToString() == "true" && !String.IsNullOrEmpty(entity.MaxNumberOfCustomFields.ToString()) ? Int32.Parse(entity.MaxNumberOfCustomFields.ToString()) + 1 : 11;

   
	   string importentitytring = Environment.NewLine + "import {"+pmName+"} from '../../EntityPMs/" + pmName + "';";
	   importentitytring += Environment.NewLine + BuildPMImportEntitesString(entity,pmName);
	 
	  Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
	  string keysstring = "";
	   
	  bool hasTenant = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey.ToString() == "true")
				{ 
					 primaryKeys.Add(field.FieldName.Trim('"'),GetTSDataType(field));

				}
			}

			if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
			 
			}
		 }


		 string tenantParam ="";
		 string tenantonlyParam = "";
		 string tenantCondition = "";
		 string tenantKeyCondition = "";
		 string getalltenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = ", int tenant";
			 tenantonlyParam = ", tenant";
			 tenantCondition = "&& a.Tenant == tenant";
			 getalltenantCondition = "\n                   where a.Tenant == tenant";

		     tenantKeyCondition = "&& a.Tenant == keys.Tenant";
         }

		 string primarykeyParam="";
		 string primaryonlyparam = "";
		 string primarykeyCondition = "";
		// string keyprimarykeyCondition = "";
		int index = 0;
		 foreach(string key in primaryKeys.Keys)
         {
		   if(index > 0)
           {
			   primaryonlyparam += "+'&'+";
           }
			 primarykeyParam +=  key.ToLower() + ": " + primaryKeys[key]+ ", ";
			 primaryonlyparam +="'" +key.ToLower() + "=' + " + key.ToLower() ;
			 primarykeyCondition += " a." + key +" == "  + key.ToLower() +" &&";
			// keyprimarykeyCondition += " a." + key +" == a."  + key +" &&";



			index++;
         }
		 
		 primarykeyParam = primarykeyParam.TrimEnd(' ').TrimEnd(',');
		 primaryonlyparam = primaryonlyparam.TrimEnd(' ').TrimEnd('&');
		 primarykeyCondition = primarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
		// keyprimarykeyCondition = keyprimarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
		 // import {InfraSettings} from '../../../../Infrastructure/Utilities/InfraSettings';
		// import {ServiceHelper} from '../../../Infrastructure/Utilities/ServiceHelper';
		//import { Observable }     from 'rxjs/Observable';
		 string infrastructureImportString = "";
		 if(modelname != null && modelname.ToLower() == "infrastructure")
         {
			 infrastructureImportString += "import {ServiceResponse} from '../../DataContracts/ServiceResponse';";
			 infrastructureImportString += Environment.NewLine + "import {ClassLevelValidator} from '../../Validators/ClassLevelValidator';";
			 infrastructureImportString += Environment.NewLine + "import {Guid} from '../../Utilities/Guid';";
			 infrastructureImportString += Environment.NewLine + "import {InfraSettings} from '../../Utilities/InfraSettings';";
			 infrastructureImportString += Environment.NewLine + "import {ServiceHelper} from '../../Utilities/ServiceHelper';";
			 infrastructureImportString += Environment.NewLine + "import {SessionInfo} from '../../Utilities/SessionInfo';";
			 infrastructureImportString += Environment.NewLine + "import {PerformanceLogger} from '../../Utilities/PerformanceLogger';";
			 infrastructureImportString += Environment.NewLine + "import {CustomFieldClass} from '../../DataContracts/CustomFieldClass'";
			 if(entity.SupportSubEntity.ToString() == "true") {
			 infrastructureImportString += Environment.NewLine + "import { CustomChildObjectPMService } from '../../Infrastructure/Services/ExtendedPMs/CustomChildObjectPMService'";
			 }

         }
		 else{
			 infrastructureImportString += "import {ServiceResponse} from '../../../Infrastructure/DataContracts/ServiceResponse';";
			 infrastructureImportString += Environment.NewLine + "import {ClassLevelValidator} from '../../../Infrastructure/Validators/ClassLevelValidator';";
			 infrastructureImportString += Environment.NewLine + "import {Guid} from '../../../Infrastructure/Utilities/Guid';";
			 infrastructureImportString += Environment.NewLine + "import {InfraSettings} from '../../../Infrastructure/Utilities/InfraSettings';";
			 infrastructureImportString += Environment.NewLine + "import {ServiceHelper} from '../../../Infrastructure/Utilities/ServiceHelper';";
			 infrastructureImportString += Environment.NewLine + "import {SessionInfo} from '../../../Infrastructure/Utilities/SessionInfo';";	
			 infrastructureImportString += Environment.NewLine + "import {CustomFieldClass} from '../../../Infrastructure/DataContracts/CustomFieldClass'";
		     if(entity.SupportSubEntity.ToString() == "true") {
			 infrastructureImportString += Environment.NewLine + "import { CustomChildObjectPMService } from '../../../Infrastructure/Services/ExtendedPMs/CustomChildObjectPMService'";
			 }
			
			 infrastructureImportString += Environment.NewLine + "import {PerformanceLogger} from '../../../Infrastructure/Utilities/PerformanceLogger';";			  
         }

		 if(applyDefaultValues)
         {
			importentitytring  += Environment.NewLine + "import {"+pmName+"InitService} from '../../EntityPMInitServices/" + pmName + "InitService';";
         }
		 if(hasCustomValidator)
         {
			importentitytring  += Environment.NewLine + "import {"+tableName+"Validator} from '../../Validators/" + tableName + "Validator';";
         }
		 string pmInitService = pmName+"InitService";

     
   #>
