<#+
public string BuildPMImportEntitesString( dynamic entity,string entityPmname)
{
	string importentitystring = "";
	

	foreach(var field in entity["field"])  //get all classes
	 { 
		  if( field.HasPMField.GetType() == typeof(string))
           {
             if(field.HasPMField == "false")
               {
                  continue;
               }
           }
		   string type = GetTSDataType(field);
		   if(type == "List" || (field.IsMulti.GetType() == typeof(string) && field.IsMulti == "true"))
           {
			   string multitableName = GetFieldMultiTableName(field);
			   if(multitableName.ToLower() != "string")
               {
				     multitableName = GetObjectTableName(multitableName);
					string pmname = multitableName + "PM";
				    string newImport = Environment.NewLine + "import {"+pmname+"} from '../../EntityPMs/" + pmname + "';";
		            if(field.ModelName.GetType() == typeof(string) && field.ModelName != null)
                    {
                         newImport = Environment.NewLine + "import {"+pmname+"} from '../../../" + field.ModelName.ToString().Trim('"') + "/EntityPMs/" + pmname + "';";
                    }
					if(!importentitystring.Contains(newImport) && pmname != entityPmname)
					 {
                        importentitystring += newImport;//Environment.NewLine + "import {"+pmname+"} from '../../EntityPMs/" + pmname + "';";

						 string importInsideEntitiesString = this.GenerateInsideCompisitionCode(multitableName,"import {{ChildEntityPMName}} from '../../EntityPMs/{ChildEntityPMName}';",false);
						  //importInsideEntitiesString = this.GenerateInsideCompositionImportStrings(field,importentitystring);
						 if(!string.IsNullOrEmpty(importInsideEntitiesString) &&  !importentitystring.Contains(importInsideEntitiesString))
                         {
							 importentitystring += Environment.NewLine + importInsideEntitiesString;
                         }
                     }
               }



           }
		   
	 }

	 return importentitystring;
}

private string GenerateInsideCompositionImportStrings(dynamic field,string importInsideEntitiesString){

	string multitableName = GetFieldMultiTableName(field);
	multitableName = GetObjectTableName(multitableName);
	string fieldName = field.FieldName.ToString().Trim('"');
	string pmname = GetFieldMultiTableName(field) + "PM";

	string parentpmname = GetFieldObjectTableName(field) + "PM";

	if(multitableName.ToLower() == "string")
               {
				   return "";
               }

	string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
string xmlFilePath = Path.Combine(templateDirectory, SrcFolder) + "/"+multitableName + ".lxml";
if(Directory.Exists(xmlFilePath) || File.Exists(xmlFilePath))
  {
	  int gcount = 0;
	 var childEntity = FromEntityPMServiceFile(xmlFilePath);
	 foreach(var childEntityfield in childEntity["field"])  
	     { 
		  // string childEntityfieldName = childEntityfield.FieldName.ToString().Trim('"');
		   if( childEntityfield.HasPMField.GetType() == typeof(string))
           {
             if(childEntityfield.HasPMField == "false")
               {
                  continue;
               }
           }
		   string type = GetTSDataType(childEntityfield);
		   string childfieldName = childEntityfield.FieldName.ToString().Trim('"');
		   string childEntityPMName = GetFieldMultiTableName(childEntityfield) + "PM";
		   if(type == "List" || (childEntityfield.IsMulti.GetType() == typeof(string) && childEntityfield.IsMulti == "true"))
           { 
			   string childmultitableName = GetFieldMultiTableName(childEntityfield);
			   if(childmultitableName.ToLower() == "string")
               {
				   continue;
               }
			   if( childEntityfield.IsComposition.GetType() == typeof(string) && childEntityfield.IsComposition == "true")
                {
						gcount++;
				      importInsideEntitiesString = Environment.NewLine + this.GenerateInsideCompisitionCode(childmultitableName,"import {{ChildEntityPMName}} from '../../EntityPMs/{ChildEntityPMName}';",false);
					 //importInsideEntitiesString = this.GenerateInsideCompositionImportStrings(childEntityfield, importInsideEntitiesString);
				}
		    }
         }

  }
 
  return importInsideEntitiesString;
}
