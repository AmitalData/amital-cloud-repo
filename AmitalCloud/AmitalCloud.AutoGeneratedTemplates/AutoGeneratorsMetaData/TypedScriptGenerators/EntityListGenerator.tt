<#+
dynamic listnamespacestringts;
public void GenerateAllListTS(string sourceFolder,string destinationFolder)
{
	// System.Diagnostics.Debugger.Launch();
	Console.WriteLine(destinationFolder);
 
 listnamespacestringts = GetListTSNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	Console.WriteLine(fileNameWithoutExtension);
	GenerateListTS(file,destinationFolder+"/"+fileNameWithoutExtension+"List.ts");
	 
}

 
}
#>

<#+  

public void GenerateListTS(string xmlFilePath,string outputFilePath)
{
	if(string.IsNullOrEmpty(listnamespacestringts))
    {
	 listnamespacestringts = GetListTSNameSpace(outputFilePath);
    }
 
var entity = FromListTSFile(xmlFilePath);
	 if( entity.IsComposition.GetType() == typeof(string))
      	{
	    	if(entity.IsComposition == "true")
	    	{
	    		return;
	    	}
	    } 
		 if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
WriteListTSMethod(entity);
SaveListTSOutput(outputFilePath);
}
 
#>


<#+

public dynamic GetListTSNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}

#>

<#+
void SaveListTSOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
    
	   var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>


<#+

 private void WriteListTSMethod(dynamic entity)
{
	string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	string schema ="";
	
	string parentname = "";
	if(entity.NoTS.GetType() == typeof(string))
      	{
	    	if(entity.NoTS == "true")
	    	{
	    		return;
	    	}
	    } 
	 
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
		schema = entity.ObjectTableName.Trim('"').ToString().Split('.')[0];

		 
          
    }
	
	

#>
