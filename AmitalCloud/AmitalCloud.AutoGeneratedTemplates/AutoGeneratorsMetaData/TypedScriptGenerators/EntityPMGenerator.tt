<#+
public string BuildImportEntitesString( dynamic entity,string entityPmname)
{
	string importentitystring = "";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
	   string parentname = GetObjectTableName(entity.ParentTableName.ToString().Trim('"')) + "PM";
	  
		string newImport = Environment.NewLine + "import {"+parentname+"} from './" + parentname + "';";
			   if(!importentitystring.Contains(newImport) && parentname != entityPmname)
               {
				    importentitystring += Environment.NewLine + "import {"+parentname+"} from './" + parentname + "';";

               }
    }

	foreach(var field in entity["field"])  //get all classes
	 { 
		  if( field.HasPMField.GetType() == typeof(string))
           {
             if(field.HasPMField == "false")
               {
                  continue;
               }
           }
		   string type = GetTSDataType(field);
		   if(type == "List" || (field.IsMulti.GetType() == typeof(string) && field.IsMulti == "true"))
           {
			   var tableName = GetFieldMultiTableName(field);
			   if(tableName.ToLower() != "string")
               {
					string pmname = tableName + "PM";
                    string newImport = Environment.NewLine + "import {"+pmname+"} from './" + pmname + "';";
                    if(!importentitystring.Contains(newImport) && pmname != entityPmname)
                    {
                        importentitystring += newImport;//Environment.NewLine + "import {"+pmname+"} from './" + pmname + "';";
                    }
               }
           }
		   
	 }

	 return importentitystring;
}
 #>

<#+
public void WritePMTSProperty(dynamic field,string tableName)
{
	string type = GetTSDataType(field); 
    string privatepropname = FirstCharacterToLowerTS(field.FieldName.Trim('"'));
	string publicpropname = field.FieldName.ToString().Trim('"');
 if( field.IsCustom.GetType() == typeof(string) && field.IsCustom == "true")
 {
 type = "CustomFieldClass";
 }
if(type=="CustomFieldClass")
{
	#>
    private <#= privatepropname #>: <#= type #>;
    public get <#= publicpropname #>() {if(!this.<#= privatepropname #>){ this.<#= privatepropname #> = new <#= type #>(null, "<#= publicpropname #>", "<#=tableName #>");} return this.<#= privatepropname #>; }
    public set <#= publicpropname #>(newValue: <#= type #>) {  this.<#= privatepropname #> = newValue; this.MarkAsDirty("<#= publicpropname #>");  }
       
	 
<#+ 
}
else
{
	#>
    private <#= privatepropname #>: <#= type #>;
    public get <#= publicpropname #>() { return this.<#= privatepropname #>; }
    public set <#= publicpropname #>(newValue: <#= type #>) { if (this.<#= privatepropname #> != newValue) { this.<#= privatepropname #> = newValue; this.MarkAsDirty("<#= publicpropname #>"); } }
       
	 
<#+ 
}
  
 }
#>

