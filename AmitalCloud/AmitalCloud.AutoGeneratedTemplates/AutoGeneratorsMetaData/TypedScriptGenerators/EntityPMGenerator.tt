<#+
public  string FirstCharacterToLowerTS(string str)
{
    if (String.IsNullOrEmpty(str) || Char.IsLower(str, 0))
        return str;

    return Char.ToLowerInvariant(str[0]).ToString() + str.Substring(1);
}
#>


<#+
public void WritePMListTS(dynamic field)
{ 
   
    bool isComposition = false;
	if(field.IsComposition.GetType() == typeof(string) && field.IsComposition == "true")
    {
	    
	   isComposition = true;
    } 

    string privatepropname = FirstCharacterToLowerTS(field.FieldName.Trim('"'));
	string publicpropname = field.FieldName.ToString().Trim('"');
    string multitablename = GetFieldMultiTableName(field);
	
	#>
     
	private <#= privatepropname #>: <#= multitablename #><#+ if(multitablename != "string"){#>PM<#+}#>[];
    get  <#= publicpropname #>() {
        if (this.<#= privatepropname #> == null) {
            this.<#= privatepropname #> = [];
        }

        return this.<#= privatepropname #>;
    }
    set  <#= publicpropname #>(newValue: <#= multitablename #><#+ if(multitablename != "string"){#>PM<#+}#>[]) {
        if (this.<#= privatepropname #> != newValue) {
            this.<#= privatepropname #> = newValue;
        }
    }
<#+ if(isComposition)
{
#>
    public Add<#= multitablename #>(item: <#= multitablename #>PM) {
        if (item != null) {
            var index = this. <#= publicpropname #>.indexOf(item);
            if (index == -1) {
<#+ if((field.IsMulti.GetType() == typeof(string) && field.IsMulti == "true"))
{
#>
                item.EntityParentPM = this;
<#+
}
#>
                this. <#= publicpropname #>.push(item);
                this.MarkAsDirty();
            }
        }
    }
    public Remove<#= multitablename #>(item: <#= multitablename #>PM) {
        if (item != null) {
            var index = this. <#= publicpropname #>.indexOf(item);
            if (index > -1) {
                this. <#= publicpropname #>.splice(index, 1);
                this.MarkAsDirty();
            }
        }
    }
    //public <#= publicpropname #>: Array<<#= multitablename #>PM>= [];
 <#+ 
 }
}
#>



<#+
//Create an elastic object
private dynamic FromPMTSFile(string file)
{
   var path= Host.ResolvePath(file);
   return XDocument.Load(path).Root.ToElastic();
}

#>



