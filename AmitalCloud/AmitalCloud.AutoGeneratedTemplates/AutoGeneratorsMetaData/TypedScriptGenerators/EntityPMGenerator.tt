	    	{
	    		return;
	    	}
	    } 
	if(entity.ParentTableName.GetType() == typeof(string))
    {
	   parentname = entity.ParentTableName.ToString().Trim('"') + "PM";
	   hasParent = true;
    }

	bool ApplyOnPropertyChangedCode = false;
	if(entity.ApplyOnPropertyChangedCode.GetType() == typeof(string)  && entity.ApplyOnPropertyChangedCode == "true")
    {
			 ApplyOnPropertyChangedCode = true;
			importString  += Environment.NewLine + "import {"+pmName+"CustomCode} from '../EntityPMCustomCode/" + pmName + "CustomCode';";
    }

   if(entity.AllowCustomFields.GetType() == typeof(string)  && entity.AllowCustomFields == "true" && entity.IsComposition.GetType() == typeof(string)  && entity.IsComposition == "true")
    {
	   hasCompstionCustomField = true;
    }

	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
		schema = entity.ObjectTableName.Trim('"').ToString().Split('.')[0];

		 
		 
          
    }
	else{

		string[] namespacearr = pmnamespacestring.ToString().Split('.');
		string projectname = namespacearr[1].Replace("Lib","");
		 
		 
		 
    }

 

	//Logitude.BookingLib.BL.EntityPMs
