	bool hasParent = false;
    bool hasCompstionCustomField = false;

    if(entity.IsLock.GetType() == typeof(string))
	{
		if(entity.IsLock == "true") 
        {
          isLock = true;
          string thisKey =  entity?.ThisKey.Trim('"');
          thisPrimeryKey = thisKey.Split(',')[0];
        }
    }
	if(entity.NoTS.GetType() == typeof(string))
      	{
	    	if(entity.NoTS == "true")
	    	{
	    		return;
	    	}
	    } 
         if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
