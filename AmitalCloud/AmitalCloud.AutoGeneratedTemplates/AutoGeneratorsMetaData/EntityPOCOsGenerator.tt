<#+

dynamic namespacestring;
Dictionary<string,string> addedProperties = new	Dictionary<string,string>();
public void GenerateAllPocos(string sourceFolder,string destinationFolder)
{
	 

 namespacestring = GetPocoNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GeneratePoco(file,destinationFolder+"/"+fileNameWithoutExtension+".cs");
}

 
}
#>



<#+  

public void GeneratePoco(string xmlFilePath,string outputFilePath)
{
	
	addedProperties = new	Dictionary<string,string>();
	if(string.IsNullOrEmpty(namespacestring))
    {
		namespacestring = GetPocoNameSpace(outputFilePath);
    }
    var entity = FromFile(xmlFilePath);
		 if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
    WritePOCOMethod(entity);
    SavePocoOutput(outputFilePath);
    
}
 
#>


<#+

public dynamic GetPocoNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	
	spacestring = spacestring.ToString().Trim('.');
 
	return spacestring;
}

#>

<#+
void SavePocoOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	

	   var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString().Trim('\n'));
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>


<#+
 private void WritePOCOMethod(dynamic entity)
{
		
	string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	string schema ="";
	string classAttribute = "[Table(,Schema=\"Customs\")]";
	if(tableName.ToString().Trim('"').Contains(".") && dBTableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		schema = tableName.ToString().Split('.')[0];
		dBTableName = dBTableName.ToString().Split('.')[1];
		
		classAttribute = "[Table(\""+dBTableName+"\",Schema="+ schema + "\")]";
    }
	else
    {
		 
		classAttribute = "[Table("+dBTableName+",)]";
    }

  if(dBTableName.Length > 30)
    {
		dBTableName = dBTableName.Substring(0,30);
    }
	 
	 string infraNameSpace = "";
	 if(entity.ClientModuleName.ToString().Trim('"') == "CRM"){ 
		infraNameSpace = "using Logitude.Infrastructure.Data.EntityPOCOs;";
	 }
