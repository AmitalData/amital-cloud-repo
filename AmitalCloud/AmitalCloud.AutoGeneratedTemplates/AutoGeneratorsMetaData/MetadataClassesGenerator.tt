	   string PredefinedValue2 = "null";
	   var CustomPredefinedAttr = Column.Attributes().Where(a => a.Name == "CustomPredefined").FirstOrDefault();
	   string CustomPredefined;
		if (CustomPredefinedAttr == null)
		{
			 CustomPredefined = "false";
		}
		else
		{
			  CustomPredefined =  CustomPredefinedAttr.Value.ToString().ToLower().Trim('"');  
		}
       var OperatorAttr = Column.Attributes().Where(a => a.Name == "Operator").FirstOrDefault();
       string Operator = "";
	   if(PredefinedValue2Attr != null)
	   {
			PredefinedValue2 = PredefinedValue2Attr.Value;
	   }
       if(OperatorAttr != null)
	   {
			Operator = OperatorAttr.Value;
	   }
	   var ObjectFieldName = Column.Attributes().Where(a => a.Name == "ObjectFieldName").FirstOrDefault().Value; 
       var FieldCode= TblName.Trim('"') + "." + ObjectFieldName.Trim('"');
