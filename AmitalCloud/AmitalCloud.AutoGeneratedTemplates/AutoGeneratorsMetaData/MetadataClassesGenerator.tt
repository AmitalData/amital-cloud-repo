<#+
	  private string GenerateHashString(string entityString)
        {
            if (String.IsNullOrEmpty(entityString))
            {
                return "NULL";
            }

            MD5CryptoServiceProvider cryptoServiceProvider = new MD5CryptoServiceProvider();
            byte[] stringBytes = Encoding.UTF8.GetBytes(entityString);
            byte[] computedHash = cryptoServiceProvider.ComputeHash(stringBytes);
            StringBuilder stringBuilder = new StringBuilder();

            foreach (var h in computedHash)
            {
                stringBuilder.Append(h.ToString("x2").ToLower());
            }

            return stringBuilder.ToString();
        }

Dictionary<string, string> GeneratedTabFeatures = new Dictionary<string, string>();
Dictionary<string, string> GeneratedTabTextCodes = new Dictionary<string, string>();
 string entityHashString= "NULL";
 private void WriteUpdateClassMethod(XElement entity,string destinationFolder,string projectname)
{
		
    entityHashString= GenerateHashString(entity.ToString());
	string repnamespacestring = GetBaseUsingNameSpace(destinationFolder);

	string tableName = entity.Attribute(XName.Get("ObjectTableName")).Value.ToString().Trim('"');
	string dBTableName = entity.Attribute(XName.Get("DBTableName")).Value.ToString();
	if(tableName.Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }


		bool iswrongname = false;
		string[] namespacearr = repnamespacestring.ToString().Split('.');
		//string projectname = "";
		if (namespacearr.Count()>1)
		{
		namespacearr[1].Replace("Lib","");
		}

        if (projectname != "Accounting" && projectname != "Booking"  && projectname != "Warehouse" && projectname != "TimeManagement" 
		&& projectname != "TariffModule" && projectname != "CargoTracking" && projectname != "ShipmentOrderModule" && projectname != "Workflow" 
		&& projectname != "DashboardModule" && projectname != "Shipment" && projectname != "Quote" )
        {
		 iswrongname = true;
        }
        else
        {
	       iswrongname = false;  
        }




	string repositoriesnamespacestring = "";
	string pocosnamespacestring = "";
	string blnamespacestring = "";
	string closetablenamespacestring = "";
	if (repnamespacestring.ToString().LastIndexOf('.')>=0)
	{
		repositoriesnamespacestring = repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".Data" + (iswrongname? ".Repsitories" : ".Repositories"); 
		pocosnamespacestring = repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".Data.EntityPOCOs";
		blnamespacestring = repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".BL";
		if (projectname != "Accounting" && projectname != "Shipment" && projectname != "DashboardModule"  && projectname !=  "Infrastructure" && projectname != "CargoTracking")
		{
			closetablenamespacestring = repnamespacestring.ToString().Substring(0,repnamespacestring.ToString().LastIndexOf('.')) + ".BL.CLoseTable";
		}

	}
	else
	{
		repositoriesnamespacestring = "";
		pocosnamespacestring = "";
		blnamespacestring = "";
		closetablenamespacestring = "";
	}


	if (projectname == "Global")
	{
		repositoriesnamespacestring = "Simplog.Global.Data.GlobalModel.Repositories";
	}
	if (projectname == "Invoice" || projectname == "Shipments" || projectname == "Quote")
	{
		repositoriesnamespacestring = $"Simplog.Data.{projectname}Model.Repositories";
		pocosnamespacestring = $"Simplog.Data.{projectname}Model.EntityPOCOs";
	}

