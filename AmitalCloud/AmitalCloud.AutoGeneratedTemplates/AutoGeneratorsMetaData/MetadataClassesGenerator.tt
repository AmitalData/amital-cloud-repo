        if (IsHeaderScreen.ToLower() == "true")
        { 
		#>
	
		    <#= TblName.Trim('"').Replace(" ","").Replace(".","") #>ObjectTable.HeaderScreenId = <#= screenClassName #>.Id;
		    <#= TblName.Trim('"').Replace(" ","").Replace(".","") #>ObjectTable.HeaderScreenCode = <#= screenClassName #>.Code;

	   		<#+
        }
}

