<#+
private void WriteAddFieldMethod(XElement entity,XElement field)
{ 
	bool isCustomField = false;
	if(field.Attribute(XName.Get("IsCustom")) != null)
    {
		isCustomField = (field.Attribute(XName.Get("IsCustom")).Value.ToLower() == "true");
    }

	if(isCustomField)//field.Attribute(XName.Get("FieldName")).Value.Trim('"') == "Id" || field.Attribute(XName.Get("FieldName")).Value.Trim('"') == "Tenant" ||
    {
		return;
    }
	bool objectFieldNotRequired = false;
	if((field.Attribute(XName.Get("ObjectFieldNotRequired")) != null && field.Attribute(XName.Get("ObjectFieldNotRequired")).Value.Trim('"').ToLower() == "true"))
    {
		objectFieldNotRequired = true;
    }
#>

			   AddObjectsAndObjectFields.AddObjectField(new ObjectFieldsDetails() 
			   {
					 <#+
					 #><#=""#>
					 <#+
		   foreach (XAttribute p in field.Attributes())
				{  
					if(p.Name != "Id" && p.Name != "ObjectFieldNotRequired" && p.Name != "IsPrimaryKey"&& p.Name != "Order" && p.Name != "IsNullable" && p.Name != "HasDataBaseField"&& p.Name != "HasPMField" && p.Name != "AssociationName" && p.Name != "IsComposition" && p.Name != "GenerateInList" 
					&& p.Name != "IsSpellCheckedFullFieldLable" && p.Name != "IsSpellCheckedHelpLocalDefaultText" && p.Name != "IsSpellCheckedShortLocalDefaultText" && p.Name != "IsSpellCheckedListLocalDefaultText"
					&& p.Name != "IsChecked" && p.Name != "IsDeleted" && p.Name != "IsNew" && p.Name != "IsRequiered"  && p.Name != "LookUpTableId" && p.Name != "DontBuildRelationOnDB" && p.Name != "OldNames"
					&& p.Name != "FullNameTextCodeId"
					&& p.Name != "HelpTextCodeId"
					&& p.Name != "ListTextCodeId" && p.Name != "LookUpTableId"
                 && p.Name != "ModelName" && p.Name != "DontBuildRelationOnDB" && p.Name != "OldNames"
					

)
					{
					if(!string.IsNullOrEmpty(p.Value.Trim('"')))
					{
					   var propValue = p.Value.Replace("\n",@"\n");
					   if((propValue.StartsWith("\"") && propValue.EndsWith("\"") && p.Name.ToString().Contains("DefaultText")) || p.Name == "ForeignEntity" || p.Name == "NavigationPropertyName" || p.Name == "ThisKey" || p.Name == "OtherKey" || p.Name == "ShortName")
					   {
                        //&quot;Allows recording AR Payments in negative amounts using payment method &quot;Offset&quot;&quot;
					     //propValue =  (!propValue.Trim('"').Contains("\"")? "@":"") + '"'  + propValue.Trim('"').Replace("\"",  "''") + '"';
                           propValue = '"'  + FixSpecialCharacters(TrimCharacter(propValue,'"')) + '"';
					   }
						if(p.Name == "IsRequired" ||p.Name == "SystemRequired")
						{
							propValue = objectFieldNotRequired ? "false":propValue;
						}

					  #>
						<#= p.Name #> =  <#= propValue #>,
					  <#+
					}
					}
 
				}
     
			 
		 
	#>		
			   },TextCodeRepository,ObjectFieldsRepository,objectFields,textCodes,objectTables,addedFields,addedTextCodes);
 
<#+
}

