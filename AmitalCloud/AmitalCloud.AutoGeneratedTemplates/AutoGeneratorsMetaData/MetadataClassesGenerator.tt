dynamic UpdateClassnamespacestring;
dynamic modelName;
public void GenerateAllUpdateClasses(string sourceFolder,string destinationFolder, string theModelName)
{
 string projectname = theModelName.Replace("Model","");
 UpdateClassnamespacestring = GetUpdateClassNameSpace(destinationFolder).Replace("JustWebFreight.", "");
 modelName = theModelName;

 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

	//bool IsExists = System.IO.Directory.Exists(Server.MapPath(destinationFolder));
	// if(!IsExists)
    //    System.IO.Directory.CreateDirectory(Server.MapPath(destinationFolder));


foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateUpdateClass(file,destinationFolder+"/"+fileNameWithoutExtension+"UpdateClass.cs",projectname);
}

 
}
#>

<#+  

public void GenerateUpdateClass(string xmlFilePath,string outputFilePath,string projectname)
{
	if(string.IsNullOrEmpty(UpdateClassnamespacestring))
    {
	   UpdateClassnamespacestring = GetUpdateClassNameSpace(outputFilePath).Replace("JustWebFreight.", "");;
    }
    XElement entity = FromUpdateClassFile(xmlFilePath);
	 
   WriteUpdateClassMethod(entity,outputFilePath, projectname);
   SaveUpdateClassOutput(outputFilePath);
}
 
#>


<#+

public dynamic GetUpdateClassNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}

public dynamic GetBaseUsingNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');

		 if(modelName == "CommonDataModel" 	|| modelName == "GlobalModel" || modelName == "InfrastructureModel" 
		 ||modelName == "CustomsModel" ||modelName == "SocialModel"   ||modelName == "ShipmentsModel"
		 ||modelName == "SystemLogsModel" ||modelName == "QuoteModel" || modelName == "InvoiceModel"
		 )
		 {
		   return spacestring;
		 }

	
		 if(modelName == "AccountingModel" //||modelName == "CommonDataModel" 
		  ||modelName == "Infrastructure"  ||modelName ==  "CargoTrackingModel"
		 || modelName == "GlobalModel" || modelName == "CRMModel" || modelName == "TariffModule" || modelName == "Workflow"
		  || modelName =="CustomsModel"  ||modelName ==  "TimeManagement" )
		 {
		   spacestring =    "Logitude."+ modelName.Replace("Model","") +".";
		   return spacestring;
		 }
		 if( modelName == "BookingModel" || modelName == "WarehouseModel")
		 {
		   spacestring =    "Logitude."+ modelName.Replace("Model","") +"Lib.";
		   return spacestring;
		 }
		 if( modelName == "Dashboard")
		 {
		   spacestring =    "Logitude.DashboardModule.";
		   return spacestring;
		 }
		 if (modelName == "InvoiceModel" )
			{
				spacestring =    "Simplog.Data." + modelName +".";
				return spacestring;
			}

	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }
	return spacestring.ToString().Trim('.');


}


#>

