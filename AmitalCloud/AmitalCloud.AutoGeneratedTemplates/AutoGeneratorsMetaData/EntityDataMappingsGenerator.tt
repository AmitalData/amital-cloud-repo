<#+

dynamic mapnamespacestring;
 
public void GenerateAllMappingClasss(string sourceFolder,string destinationFolder)
{
	 

 mapnamespacestring = GetMappingClassNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	string filename = fileNameWithoutExtension+"DataMapping.Generated.cs";
	GenerateMappingClass(file,destinationFolder+"/Generated/"+filename,false);
	 
}

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	string filename = fileNameWithoutExtension+"DataMapping.cs";
	GenerateMappingClass(file,destinationFolder+"/"+filename,true);
	 
}
 
}
#>



<#+  

public void GenerateMappingClass(string xmlFilePath,string outputFilePath,bool isCustom)
{
	
	 
	if(string.IsNullOrEmpty(mapnamespacestring))
    {
		mapnamespacestring = GetMappingClassNameSpace(outputFilePath);
    }
    var entity = FromFile(xmlFilePath);

	 if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 

	if(isCustom)
    {
		 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
         string filepath = Path.Combine(templateDirectory, outputFilePath);
	     bool generate = true;
		 generate = !File.Exists(filepath);
       
		if(generate)
         {
		    WriteCustomMappingClassMethod(entity);
         }
	}
	else
    {
		 
		WriteMappingClassMethod(entity);
    }
    SaveMappingClassOutput(outputFilePath,isCustom);
    
}
 
#>



<#+

public dynamic GetMappingClassNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	
	spacestring = spacestring.ToString().Trim('.');
 
	return spacestring;
}

#>

<#+
void SaveMappingClassOutput(string outputFileName,bool isCustom)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	  bool save = true;
	  if(isCustom)
      {
		  save = !File.Exists(outputFilePath);
      }
	 // if(!File.Exists(outputFilePath))
    //{
	   
	  if(save)
      {
	    var manager = Manager.Create(Host, GenerationEnvironment);
	    manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	    this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
      }
    //}
  }
#>


<#+ 
 private void WriteCustomMappingClassMethod(dynamic entity)
{
	POCOFields = new List<dynamic>();
	PMFields = new List<dynamic>();
	foreach(var field in entity["field"])  
		 { 
		  if( field.HasDataBaseField.GetType() == typeof(string))
           {
             if(field.HasDataBaseField == "true")
               {
                  POCOFields.Add(field);
               }
           }
         }

		foreach(var field in entity["field"])  
		 { 
		  if( field.HasPMField.GetType() == typeof(string))
           {
             if(field.HasPMField == "true")
               {
                  PMFields.Add(field);
               }
           }
         }
	string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	string schema ="";
	 
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
        
    }
	 string pmName = tableName+ "PM";
	 string pocosspacestring = mapnamespacestring.ToString().Substring(0,mapnamespacestring.ToString().LastIndexOf('.')) + ".EntityPOCOs;";
	  string entityPMsPath=mapnamespacestring.ToString().Substring(0,mapnamespacestring.ToString().LastIndexOf('.')) + ".EntityPMs;";
	if(pocosspacestring.Contains("Accounting"))
	{
	   entityPMsPath="Logitude.Accounting.Def.EntityPMs;";
	}
	if(pocosspacestring.Contains("Shipment"))
	{
	   entityPMsPath="AmitalCloud.Shipment.Def.EntityPMs;";
	}

	if(pocosspacestring.Contains("Customs"))
	{
	   entityPMsPath="Logitude.Customs.Def.EntityPMs;";
	}
    if(pocosspacestring.Contains("CargoTracking"))
	{
	   entityPMsPath="Logitude.CargoTracking.Def.EntityPMs;";
	}
 
     if(pocosspacestring.Contains("ShipmentOrderModule"))
	{
	   entityPMsPath="Logitude.ShipmentOrderModule.Def.EntityPMs;";
	}
 	string pmsspacestring =   entityPMsPath;
     
	string dataprojectnamespace = mapnamespacestring.ToString().Substring(0,mapnamespacestring.ToString().LastIndexOf('.')).Replace("BL","Data;");
	 
	 pocosspacestring = pocosspacestring.Replace("BL","Data");
   #>
