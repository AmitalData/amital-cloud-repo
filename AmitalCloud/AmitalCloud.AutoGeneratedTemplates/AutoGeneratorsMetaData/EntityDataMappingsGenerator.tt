	    public void EncodeBase64NVARCHARFields(<#= pmName #> entityPM)
        {
            if (String.IsNullOrWhiteSpace(entityPM.EncodeBase64NVARCHARFieldsBy)) 
            {
                return;

            }
<#+		 
		 foreach(var field in POCOFields)  
        {
				bool isCustom= false;
			if(field.IsCustom.GetType() == typeof(string) && field.IsCustom == "true")
				{
					isCustom = true;
				}
            string type = GetDataType(field);
            string datatype = GetEntityMapPropertyName(field.FieldsDataType.ToString());
            if(type != "List")
            {
                if(datatype != "nText" || isCustom)
                {
                    continue;
                }
                if(PMFields.Contains(field))
                {
                    if( field.IsPrimaryKey.GetType() == typeof(string))
                    {
                        if(field.IsPrimaryKey.ToString() == "true")
                        {
                            continue;
                        }
                    }
                    dynamic fieldName = GetPropertyName(field.FieldName); 
#>
            if (!String.IsNullOrWhiteSpace(entityPM.<#=fieldName #>)) //T4 find type == nText 
            {
                entityPM.<#=fieldName #> = Encoding.GetEncoding(entityPM.EncodeBase64NVARCHARFieldsBy).GetString(Convert.FromBase64String(entityPM.<#=                    fieldName #>));
            }
<#+           
                }
            }
        }
#>
            entityPM.EncodeBase64NVARCHARFieldsBy=null;
		}


