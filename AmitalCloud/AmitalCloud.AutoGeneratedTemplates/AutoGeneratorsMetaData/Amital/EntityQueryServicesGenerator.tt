<#+

dynamic queryservicenamespacestring;
Dictionary<string,string> Namespaces;
public void GenerateAllQueryServices(string sourceFolder,string destinationFolder,string contextName,Dictionary<string,string> namespaces)
{
Namespaces = namespaces;
 queryservicenamespacestring = GetQueryServiceNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string outputFilePath = Path.Combine(templateDirectory, sourceFolder);
foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{
    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateEntityQueryService(file,destinationFolder+"/Generated/"+fileNameWithoutExtension+"QueryService.Generated.cs",contextName);
}
}
#>

<#+  

public void GenerateEntityQueryService(string xmlFilePath,string outputFilePath,string contextName)
{
	if(string.IsNullOrEmpty(queryservicenamespacestring))
    {
		queryservicenamespacestring = GetQueryServiceNameSpace(outputFilePath);
    }

var entity = FromEntityQueryServiceFile(xmlFilePath);
 if( entity.NoObjectTable.GetType() == typeof(string))
	{
		if(entity.NoObjectTable == "true")
		{
			return;
		}
	}
		 if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
 
    WriteEntityQueryServiceMethod(entity,contextName);
    SaveEntityQueryServiceOutput(outputFilePath);

 }
#>

<#+

public dynamic GetQueryServiceNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}

#>

<#+
void SaveEntityQueryServiceOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
      

	   var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>


<#+
 private void WriteEntityQueryServiceMethod(dynamic entity,dynamic contextName)
{
    string tableName = entity.ObjectTableName.Trim('"');
	string pmName = tableName + "PM";
	string listName = tableName + "List";
	string keysName = tableName+"Keys";
	string dBTableName = entity.DBTableName.Trim('"');
    string[] namespacearr = queryservicenamespacestring.ToString().Split('.');
    string projectname = namespacearr[1].Replace("Lib","");
	string parententity = "object";
	string parentKeys = tableName + "Keys";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
		parententity = entity.ParentTableName.Trim('"') +"PM";
		parentKeys =entity.ParentTableName.Trim('"') + "Keys";
    }
	  Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
	  string keysstring = "";
	string pocokeystring="";
	  string primarykeyParam="";
	  string keyType="";
	  bool hasTenant = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey.ToString() == "true")
				{ 
					keyType = GetDataType(field);
					 primaryKeys.Add(field.FieldName.Trim('"'),keyType);
					keysstring += field.FieldName.Trim('"') + " = "+field.FieldName.Trim('"').ToLower() + ", ";
					primarykeyParam += keyType+ " " + field.FieldName.Trim('"').ToLower() + ", ";
					 pocokeystring += field.FieldName.Trim('"') + " = entityPOCO."+field.FieldName.Trim('"')+", ";
				}
			}
			if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
			}
		 }
		 keysstring = keysstring.TrimEnd(' ').TrimEnd(',');
		 primarykeyParam = primarykeyParam.TrimEnd(' ').TrimEnd(',');
		 string tenantParam = "";
		 string tenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = "int tenant";
			 tenantCondition = "where a.Tenant == tenant";
         }
   #>
