<#+
dynamic pmnamespacestring;

public void GenerateAllPMs(string sourceFolder, string destinationFolder,Dictionary<string,string> namespacesparam)
{
	NamespacesDictionary = namespacesparam;
	pmnamespacestring = GetPMNameSpace(destinationFolder);
	string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
	string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);
	
	foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
	{
		var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
		GeneratePM(file, destinationFolder + "/Generated/" + fileNameWithoutExtension + "PM.Generated.cs");
	}
}
#>

<#+
public void GeneratePM(string xmlFilePath, string outputFilePath)
{
	if (string.IsNullOrEmpty(pmnamespacestring))
	{
		pmnamespacestring = GetPMNameSpace(outputFilePath);
	}

	var entity = FromPMFile(xmlFilePath);

	if (entity.IsMetadataOnlyTable.GetType() == typeof(string) && entity.IsMetadataOnlyTable == "true")
	{
		return;
	}

	WritePMMethod(entity);
	SavePMOutput(outputFilePath);
}
#>

<#+
public dynamic GetPMNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach (string dir in path)
	{
		if (dir != "..")
		{
			spacestring += dir + ".";
		}
	}

	spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}
#>

<#+
void SavePMOutput(string outputFileName)
{
	string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
	string outputFilePath = Path.Combine(templateDirectory, outputFileName);

	var manager = Manager.Create(Host, GenerationEnvironment);
	manager.CreateTestFile(outputFilePath, this.GenerationEnvironment.ToString());
	this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
}
#>

<#+
string classlevelname = "ClassLevelValidator";
string validationclassname = "ValidationClass";

private void WritePMMethod(dynamic entity)
{
	string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	string schema = "";

	if (tableName.ToString().Trim('"').Contains("."))
	{
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
		schema = entity.ObjectTableName.Trim('"').ToString().Split('.')[0];
		classlevelname = schema + "ClassLevelValidator";
		validationclassname = "I"+schema + "ValidationClass";
	}
	else
	{
		string[] namespacearr = pmnamespacestring.ToString().Split('.');
		string projectname = namespacearr[1].Replace("Lib", "");
		classlevelname = projectname + "ClassLevelValidator";
		validationclassname = "I"+projectname + "ValidationClass";
	}

	string validatorsnamespace = pmnamespacestring.ToString().Substring(0, pmnamespacestring.ToString().LastIndexOf('.')) + ".Validators;";
	bool allowCustomFields = false;
	string usingStatements = "";

	if (entity.AllowCustomFields.GetType() == typeof(string) && entity.AllowCustomFields == "true")
	{
		allowCustomFields = true;
	}
	string pocostr= "";
	foreach (var field in entity["field"])
	{
	if (field.NameSpace != null && !(field.NameSpace is AmazedSaint.Elastic.Lib.ElasticObject))
    {
        string rawNamespace = field.NameSpace.ToString().Trim('"');
        if (!string.IsNullOrEmpty(rawNamespace))
        {
            // Check if HasPMField exists and if it is set to "false"
            if (field.HasPMField != null && field.HasPMField.ToString() == "false")
            {
                continue; // Skip if HasPMField is "false"
            }

            // Append the namespace with ".Def.EntityPMs" if it's a valid PM field

			if (rawNamespace.Contains("AmitalCloud"))
 			{
				pocostr = "Domain";
			}
			else
			{
				pocostr = "Def";
			}

            usingStatements += $"using {rawNamespace}.{pocostr}.EntityPMs;\n";
        }
		}
	}

