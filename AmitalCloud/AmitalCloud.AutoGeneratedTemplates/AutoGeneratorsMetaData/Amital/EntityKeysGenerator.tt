<#+
dynamic keynamespacestring;
public void GenerateAllKeys(string sourceFolder,string destinationFolder,Dictionary<string,string> namespacesparam)
{
 NamespacesDictionary = namespacesparam;
 keynamespacestring = GetKeyNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateKey(file,destinationFolder+"/"+fileNameWithoutExtension+"Keys.cs");
}

 
}
#>

<#+  

public void GenerateKey(string xmlFilePath,string outputFilePath)
{
	if(string.IsNullOrEmpty(keynamespacestring))
    {
	 keynamespacestring = GetKeyNameSpace(outputFilePath);
    }
var entity = FromKeyFile(xmlFilePath);
          if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
WriteKeyMethod(entity);
SaveKeyOutput(outputFilePath);
}
 
#>


<#+

public dynamic GetKeyNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}

#>

<#+
void SaveKeyOutput(string outputFileName)
  { 
	 //outputFileName =  "../../Logitude.Customs.MetaData/EntityKeys/AutonomyTypeKeys.cs";
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	   
	  var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>


<#+
 private void WriteKeyMethod(dynamic entity)
{
       
	string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }
    string convertstring = "";
	string predicatestring = "";  
	foreach(var field in entity["field"]) { if( field.IsPrimaryKey.GetType() == typeof(string)) 	 {if(field.IsPrimaryKey.ToLower() == "true")
	{
		if (predicatestring != "")
		{
			predicatestring = predicatestring + " && ";
		}
		predicatestring = predicatestring + "a." + field.FieldName.ToString().Trim('"') + " == " + field.FieldName.ToString().Trim('"') ;
	}}}
   #>
