<#+ private void GenerateChangeSetCombosition(dynamic entity,string pmName,string ForLoop,string MainEntity)
    {
		    string multitablenewname = "";
		    string multitablename = "";
	    	string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
             string outputFilePath = Path.Combine(templateDirectory, SrcFolder);
		  	foreach(var field in entity["field"])  
	        { 
		   
		      string type = GetDataType(field);  
		      if(type == "List")
              { 
			    if(field.IsComposition.GetType() == typeof(string) && field.IsComposition.ToString().ToLower() == "true")
                { 
					if(field.MultiTableName.GetType() == typeof(string))
                    {
						  multitablename = field.MultiTableName.Trim('"');
					      if(!string.IsNullOrEmpty(multitablename) && multitablename.Contains("."))
					      {
							multitablename = multitablename.Split('.')[1]; 
						  } 
			#>

            List<<#= multitablename #>PM> <#= multitablename #>sChangeSet = ChangeSet.GetAssociatedChanges(<#= MainEntity #>, d => d.<#= multitablename #>s).Cast<<#= multitablename #>PM>().ToList();
            foreach (<#= multitablename #>PM <#= ForLoop #> in <#= multitablename #>sChangeSet)
            {  <#+
						string file = Directory.EnumerateFiles(outputFilePath, "*.lxml").Where(a => a.Contains(multitablename)).FirstOrDefault();
						string Keys = "";
						List<string> CompositionMethods = new List<string>();
						List<string> KeysList = new List<string>();
                        if (!string.IsNullOrEmpty(file))
                        { 
							var temp = FromEntityDomainServiceFile(file);
							foreach(var field1 in temp["field"])  
	                        {  
								string fieldtype = GetDataType(field);
							    if( field1.IsPrimaryKey.GetType() == typeof(string))
      	                        {
	                                if(field1.IsPrimaryKey == "true")
	                            	{
										if( field1.IsPrimaryKey.GetType() == typeof(string))
      	                                {
											KeysList.Add( field1.FieldName.Trim('"'));
                                            if (string.IsNullOrEmpty(Keys))
                                            {
		                                        Keys = "d." + field1.FieldName.Trim('"') + " == " + ForLoop + "." + field1.FieldName.Trim('"');
                                            }
                                            else
                                            {
	                                            Keys += " && d." + field1.FieldName.Trim('"') + " == " + ForLoop + "." + field1.FieldName.Trim('"');
                                            } 
                                        } 			 
	    	                        }
	                            }
                                        if(fieldtype == "List")
                                        {
			                                if(field1.IsComposition.GetType() == typeof(string) && field1.IsComposition.ToString().ToLower() == "true")
                                            { 
				                              	if(field1.MultiTableName.GetType() == typeof(string))
                                                {
						                            multitablenewname = field1.MultiTableName.Trim('"');
					                                if(!string.IsNullOrEmpty(multitablenewname) && multitablenewname.Contains("."))
					                                {
						                               	multitablenewname = multitablenewname.Split('.')[1]; 
						                            } 
													CompositionMethods.Add("Set" + multitablenewname + "ChangeSet(currentItemPM);"); 
											    }  
                                            }
                                        } 
                            }
                        }
						#>

                <#= MainEntity #>.<#= multitablename #>s.Where(d => <#= Keys #>).FirstOrDefault().ChangeSetOp = ChangeSetOperation.Insert; <#+
				if (!string.IsNullOrEmpty(multitablenewname) && !string.IsNullOrEmpty(multitablename))
                { 
			     string tempfile = Directory.EnumerateFiles(outputFilePath, "*.lxml").Where(a => a.Contains(multitablename)).FirstOrDefault();
			     if (!string.IsNullOrEmpty(tempfile))
