<#+  
public void GenerateEntityDomainService(string xmlFilePath,string outputFilePath,string contextName,string modelname,string domainServiceName)
{
	if(string.IsNullOrEmpty(domainservicenamespacestring))
    {
		domainservicenamespacestring = GetDomainServiceNameSpace(outputFilePath);
    }
        var entity = FromEntityDomainServiceFile(xmlFilePath);
        if( entity.GenerateDomainService.GetType() == typeof(string))
      	{
	    	if(entity.GenerateDomainService == "false" || entity.GenerateDomainService == null)
	    	{
	    		return;
	    	}
	    } 
		else
        {
	      return;      
        }
          WriteEntityDomainServiceMethod(entity,modelname,contextName,domainServiceName); 
          SaveEntityDomainServiceOutput(outputFilePath);
 }
public void GenerateEntityDomainServiceUpdateClass(string xmlFilePath,string outputFilePath,string contextName,string modelname,string domainServiceName)
{
	if(string.IsNullOrEmpty(domainservicenamespacestring))
    {
		domainservicenamespacestring = GetDomainServiceNameSpace(outputFilePath);
    }
var entity = FromEntityDomainServiceFile(xmlFilePath);
    if( entity.GenerateDomainService.GetType() == typeof(string))
	{
		if(entity.GenerateDomainService == "false" || entity.GenerateDomainService == null)
		{
			return;
		}
	}
    else
    {
	   return;      
    }
	       UseUpdateClassesNameSpace = true;
          WriteEntityDomainServiceUpdateClasses(entity,modelname,contextName,domainServiceName); 
          SaveEntityDomainServiceOutput(outputFilePath);
 }
public void GenerateEntityDomainServiceUpdateClassRegisterar(string xmlFilePath,string outputFilePath,string contextName,string modelname,string domainServiceName)
{
	if(string.IsNullOrEmpty(domainservicenamespacestring))
    {
		domainservicenamespacestring = GetDomainServiceNameSpace(outputFilePath);
    }
   var entity = FromEntityDomainServiceFile(xmlFilePath);
   if( entity.GenerateDomainService.GetType() == typeof(string))
	{
		if(entity.GenerateDomainService == "false" || entity.GenerateDomainService == null)
		{
			return;
		}
	}
	else
    {
	   return;      
    }
		 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
         string filepath = Path.Combine(templateDirectory, outputFilePath);
	     bool generate = true;
		 generate = !File.Exists(filepath);
		if(generate)
         {
			 UpdateClassesRegisterarNameSpace = true;
