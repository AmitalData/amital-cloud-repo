<#+

dynamic domainservicenamespacestring;
bool UpdateClassesRegisterarNameSpace;
bool UseUpdateClassesNameSpace;
string SrcFolder;
public void GenerateAllDomainServices(string sourceFolder,string destinationFolder,string contextName,string modelname,string domainServiceName,Dictionary<string,string> namespacesparam)
{
 NamespacesDictionary = namespacesparam;
 SrcFolder = sourceFolder;
 domainservicenamespacestring = GetDomainServiceNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string outputFilePath = Path.Combine(templateDirectory, sourceFolder);
foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{
    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateEntityDomainService(file,destinationFolder+"/DomainServices/Generated/"+fileNameWithoutExtension+"DomainService.Generated.cs",contextName,modelname,domainServiceName);
}
}
