<#+

dynamic detailsnamespacestring;
 
public void GenerateAllCloseTableDetailsEnumsClasss(string sourceFolder,string destinationFolder,Dictionary<string,string> namespacesparam)
{
	NamespacesDictionary = namespacesparam;
 detailsnamespacestring = GetCloseTableDetailsEnumClassNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

//foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
//{
//
//    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
//	string filename = fileNameWithoutExtension+"Details.Generated.cs";
//	GenerateDetailsClass(file,destinationFolder+"/DetailsClassesGenerated/"+filename);
//	 
//}

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{
    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	string filename = fileNameWithoutExtension+"Struct.Generated.cs";
	GenerateEnumClass(file,destinationFolder+"/EnumGenerated/"+filename);
}
 
}
