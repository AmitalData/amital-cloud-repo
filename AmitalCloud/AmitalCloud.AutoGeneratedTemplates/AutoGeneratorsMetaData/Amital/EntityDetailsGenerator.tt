<#+  

public void GenerateDetailsClass(string xmlFilePath,string outputFilePath)
{
	
	//var Fullentity = FromFile(xmlFilePath);
	if(string.IsNullOrEmpty(detailsnamespacestring))
    {
		detailsnamespacestring = GetCloseTableDetailsEnumClassNameSpace(outputFilePath);
    }
    XElement entity = FromDetailsClassFile(xmlFilePath);
	var CloseTableCode = entity.Attribute(XName.Get("CloseTableCode"));
	var CloseTableName = entity.Attribute(XName.Get("CloseTableName"));
	string IsCLosed = entity.Attribute(XName.Get("IsClosed")).Value.Trim('"'); 
    if (IsCLosed == "true" && CloseTableCode != null && CloseTableName != null)
    {
		 WriteDetailsClassMethod(entity); 
         SaveDetailsClassOutput(outputFilePath);
    }
	
    
}

public void GenerateEnumClass(string xmlFilePath,string outputFilePath)
{
	
	 
	if(string.IsNullOrEmpty(detailsnamespacestring))
    {
		detailsnamespacestring = GetCloseTableDetailsEnumClassNameSpace(outputFilePath);
    }
    XElement entity = FromDetailsClassFile(xmlFilePath);
    string IsCLosed = entity.Attribute(XName.Get("IsClosed")).Value.Trim('"'); 
	var CloseTableCode = entity.Attribute(XName.Get("CloseTableCode"));
	var CloseTableName = entity.Attribute(XName.Get("CloseTableName"));

			string IsMetadataOnlyTable = (entity.Attribute(XName.Get("IsMetadataOnlyTable")) != null?entity.Attribute(XName.Get("IsMetadataOnlyTable")).Value.Trim('"'):"false");
   
              if(IsMetadataOnlyTable == "true")
              {
                     return;
              }

    if (IsCLosed == "true" && CloseTableCode != null && CloseTableName != null)
    {
		 WriteEnumMethod(entity);
		 SaveEnumClassOutput(outputFilePath);
    }
   
    
}
 
#>

<#+

public dynamic GetCloseTableDetailsEnumClassNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	
	spacestring = spacestring.ToString().Trim('.');
 
	return spacestring;
}

#>

<#+
void SaveDetailsClassOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	  
	    var manager = Manager.Create(Host, GenerationEnvironment);
	    manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	    this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
     
  }

  void SaveEnumClassOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	 
	    var manager = Manager.Create(Host, GenerationEnvironment);
	    manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	    this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
     
  }
#>

<#+
 
 private void WriteDetailsClassMethod(XElement entity)
{
    bool HasCode = false;
		foreach(var field in entity.Elements("field"))  
		 { 
		 if(field.Attribute(XName.Get("FieldName")) != null)
              {
				 if(field.Attribute(XName.Get("FieldName")).Value.ToLower() == "\"code\"")
                 {
				     HasCode = true;
                 } 
              }  
         }
	string tableName = entity.Attribute(XName.Get("ObjectTableName")).Value.Trim('"');
	string dBTableName = entity.Attribute(XName.Get("DBTableName")).Value.Trim('"');
	string schema ="";
    string CloseTableCode = entity.Attribute(XName.Get("CloseTableCode")).Value.Trim('"');
	string CloseTableName = entity.Attribute(XName.Get("CloseTableName")).Value.Trim('"');
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
        
    }
	string pmName = tableName+ "PM";
   #>
