<#+

dynamic controlernamespace;
bool UpdateClassesRegisterarNameSpaceTS;
bool UseUpdateClassesNameSpaceTS;
string SrcFolderts;
public void GenerateAllControllers(string sourceFolder,string destinationFolder,string modelProjectName,string modelFolderName,Dictionary<string,string> namespacesparam)
{
NamespacesDictionary = namespacesparam;
 SrcFolderts = sourceFolder;

 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string outputFilePath = Path.Combine(templateDirectory, sourceFolder);
foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);


     controlernamespace =GetControllerNameSpace(destinationFolder+"/" + modelFolderName+ "/Generated/PMControllers");
	GenerateEntityController(file,destinationFolder+"/" + modelFolderName+ "/Generated/PMControllers/"+fileNameWithoutExtension+"Controller.Generated.cs",modelProjectName);
     controlernamespace =GetControllerNameSpace(destinationFolder+"/"+modelFolderName +"/Generated/ListControllers");
	GenerateEntityViewController(file,destinationFolder+"/"+modelFolderName +"/Generated/ListControllers/"+fileNameWithoutExtension+"ViewsController.Generated.cs",modelProjectName);
}

}
#>

<#+  

public void GenerateEntityController(string xmlFilePath,string outputFilePath,string modelname)
{
	 

        var entity = FromEntityControllerFile(xmlFilePath);
	        
	  if( entity.IsComposition.GetType() == typeof(string))
      	{
	    	if(entity.IsComposition == "true")
	    	{
	    		return;
	    	}
	    } 

		if( entity.NoPMController.GetType() == typeof(string))
      	{
	    	if(entity.NoPMController == "true")
	    	{
	    		return;
	    	}
	    } 

		if( entity.IsClosed.GetType() == typeof(string))
      	{
	    	if(entity.IsClosed == "true" && entity.ObjectTableName.Trim('"') != "PortTimeZone")
	    	{
	    		return;
	    	}
	    } 
		 if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
          WriteEntityControllerMethod(entity,modelname); 
          SaveEntityControllerOutput(outputFilePath);
 }

public void GenerateEntityViewController(string xmlFilePath,string outputFilePath,string modelname)
{
        var entity = FromEntityControllerFile(xmlFilePath);
		 if( entity.NoViewController.GetType() == typeof(string))
      	{
	    	if(entity.NoViewController == "true")
	    	{
	    		return;
	    	}
	    } 
         if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 

	  

          WriteEntityViewControllerMethod(entity,modelname); 
          SaveEntityControllerOutput(outputFilePath);
        

 }

//

#>

<#+

public dynamic GetControllerNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }
    spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}

#>

<#+
void SaveEntityControllerOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	    var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>



<#+
 private void WriteEntityControllerMethod(dynamic entity,string modelname)
{
    string tableName = entity.ObjectTableName.Trim('"');
	string fullTableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
          
    }
	string parententity = "object";
	string parentKeys = tableName + "Keys";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
		parententity = entity.ParentTableName +"PM";
		parentKeys =entity.ParentTableName + "Keys";
    }
    string listName = tableName + "List";
    string pmName = tableName + "PM";
	string keysName = tableName+"Keys";
	string queryName = FirstServiceCharacterToLowerTS(tableName)+"Query";
	 string sortbycolumnname="";
	 if(entity.SortingByObjectField.GetType() == typeof(string))
	 {
		 sortbycolumnname = entity.SortingByObjectField.Trim('"');
     }
	 if(string.IsNullOrEmpty(sortbycolumnname))
     {
		 sortbycolumnname = entity["field"][0].FieldName.Trim('"');
     }
	bool isClosed = false;
	if( entity.IsClosed.GetType() == typeof(string))
	{
	    isClosed = (entity.IsClosed == "true");
    }
	 bool enableSecurity = false;
	if( entity.EnableSecurity.GetType() == typeof(string))
	{
	    enableSecurity = (entity.EnableSecurity == "true");
    }
	  Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
	  string keysstring = "";
	  bool hasTenant = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey.ToString() == "true")
				{ 
					 primaryKeys.Add(field.FieldName.Trim('"'),GetDataType(field));
				}
			}
			if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
			}
		 }
		 string tenantParam ="";
		 string tenantonlyParam = "";
		 string tenantCondition = "";
		 string tenantKeyCondition = "";
		 string getalltenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = ", int tenant";
			 tenantonlyParam = ", tenant";
			 tenantCondition = "&& a.Tenant == tenant";
			 getalltenantCondition = "\n                   where a.Tenant == tenant";
		     tenantKeyCondition = "&& a.Tenant == keys.Tenant";
         }
		 	 string tenantStringParam = "entityPM.Tenant";
		 if(tableName == "Tenant" || tableName == "TenantManagement" || tableName == "AccountingSetting")
			 tenantStringParam = "entityPM.Id";
		 string primarykeyParam="";
		 string primaryonlyparam = "";
		 string primarykeyCondition = "";
		 foreach(string key in primaryKeys.Keys)
         {
			 primarykeyParam += primaryKeys[key]+ " " + key.ToLower() + ", ";
			 primaryonlyparam += key.ToLower() + ", ";
			 primarykeyCondition += " a." + key +" == "  + key.ToLower() +" &&";
         }
		 primarykeyParam = primarykeyParam.TrimEnd(' ').TrimEnd(',');
		 primaryonlyparam = primaryonlyparam.TrimEnd(' ').TrimEnd(',');
		 primarykeyCondition = primarykeyCondition.TrimEnd('&').TrimEnd('&').Trim(' ');
	 bool isCachedOnClient = false;
	if( entity.CacheOnClient.GetType() == typeof(string))
	{
	    isCachedOnClient = (entity.CacheOnClient == "true");
    }  
     string enableSecurityString = "false";
     string HasTenantString = "false";
     string saveHistoryString = "false";
     if (hasTenant) HasTenantString = "true";
     if(enableSecurity) enableSecurityString = "true";
     if(!isClosed  && isCachedOnClient) saveHistoryString = "true";
   #>
