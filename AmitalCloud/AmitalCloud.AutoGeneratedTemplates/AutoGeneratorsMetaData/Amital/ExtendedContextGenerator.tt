<#+
void ExtendedSaveContextOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	  var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString().Trim('\n'));
      this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>

<#+  

private void ExtendedGenerateIDbSet(string xmlFilePath)
{
    var entity = ExtendedFromEntityFile(xmlFilePath);
            if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
	 string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	if(tableName.Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
    }
	#>
	 IDbSet<POCO.<#= tableName #>> <#= dBTableName #> { get; }
	<#+
}
#>

<#+
//Create an elastic object
private dynamic ExtendedFromEntityFile(string file)
{
   var path= Host.ResolvePath(file);
   return XDocument.Load(path).Root.ToElastic();
}

#>

<#+

private string ExtendedGetContextNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	
	spacestring = spacestring.ToString().Trim('.');
 
	return spacestring;
}

#>


<#+

private void GenerateExtendedContext(string sourceFolder,string destinationFolder,string contextname,string fileName,string POCOnamespace)
{
	string contextnamespacestring = ExtendedGetContextNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);
string dataprojectnamespace = contextnamespacestring.ToString().Substring(0,contextnamespacestring.ToString().LastIndexOf('.')) + ";";
string mappingsspacestring = contextnamespacestring.ToString().Substring(0,contextnamespacestring.ToString().LastIndexOf('.')).Replace("Data","Domain") + ".EntityMapping;";
#>
//------------------------------------------------------------------------------
// <auto-generated>
//     This code was generated by an Amital.
//     Changes to this file may cause incorrect behavior and will be lost if
//     the code is regenerated.
// </auto-generated>
//-----
using System.Data.Entity;
using POCO = <#= POCOnamespace #> ;

namespace <#= contextnamespacestring #>
{
   public partial class <#= contextname #>
    {
 
<#+

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{
    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	ExtendedGenerateIDbSetForContext(file);
}
#>
 }
}
<#+     
	ExtendedSaveContextOutput(destinationFolder+"/"+contextname +"_"+fileName+".cs");
}



