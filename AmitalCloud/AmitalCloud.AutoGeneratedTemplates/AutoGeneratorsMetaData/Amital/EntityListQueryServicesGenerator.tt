<#+

dynamic querylistservicenamespacestring;
public void GenerateAllListQueryServices(string sourceFolder,string destinationFolder,string contextName,Dictionary<string,string> namespacesparam)
{
 NamespacesDictionary = namespacesparam;
 querylistservicenamespacestring = GetListQueryServiceNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string outputFilePath = Path.Combine(templateDirectory, sourceFolder);
foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateEntityListQueryService(file,destinationFolder+"/Generated/"+fileNameWithoutExtension+"ListQueryService.Generated.cs",contextName,false);
}

//foreach (string file in Directory.EnumerateFiles(outputFilePath, "*.lxml"))
//{
//    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
//	GenerateEntityListQueryService(file,destinationFolder+"/"+fileNameWithoutExtension+"ListQueryService.cs",contextName,true);
//}
 
}
#>

<#+  

public void GenerateEntityListQueryService(string xmlFilePath,string outputFilePath,string contextName,bool isCustom)
{
	if(string.IsNullOrEmpty(querylistservicenamespacestring))
    {
		querylistservicenamespacestring = GetListQueryServiceNameSpace(outputFilePath);
    }

var entity = FromEntityListQueryServiceFile(xmlFilePath);
		 if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
 if( entity.NoObjectTable.GetType() == typeof(string))
	{
		if(entity.NoObjectTable == "true")
		{
			return;
		}
	}
 
	if(isCustom)
    {
		 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
         string filepath = Path.Combine(templateDirectory, outputFilePath);
	     bool generate = true;
		 generate = !File.Exists(filepath);
       
		if(generate)
         {
		      WriteCustomEntityListQueryServiceMethod(entity,contextName);
			  SaveEntityListQueryServiceOutput(outputFilePath);
         }
    }
	else
    {
      WriteEntityListQueryServiceMethod(entity,contextName);
      SaveEntityListQueryServiceOutput(outputFilePath);
    }

 }
#>

<#+

public dynamic GetListQueryServiceNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	spacestring = spacestring.ToString().Trim('.');

	return spacestring;
}

#>

<#+
void SaveEntityListQueryServiceOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
    
	  var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString());
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>

<#+	
private void WriteCustomEntityListQueryServiceMethod(dynamic entity,dynamic contextName)
{
	string tableName = entity.ObjectTableName.Trim('"');
	string dBTableName = entity.DBTableName.Trim('"');
	bool iscustoms = false;
	if(tableName.ToString().Trim('"').Contains("."))
    {
		tableName = tableName.ToString().Split('.')[1];
		dBTableName = dBTableName.ToString().Split('.')[1];
		iscustoms =  true;
          
    }
	 Dictionary<string,string> primaryKeys = new Dictionary<string,string>();
	 bool hasTenant = false;
		 foreach(var field in entity["field"])
		 {
		  if( field.IsPrimaryKey.GetType() == typeof(string))
			{
				if(field.IsPrimaryKey.ToString() == "true")
				{ 
					 primaryKeys.Add(field.FieldName.Trim('"'),GetDataType(field));

					//keysstring += field.FieldName.Trim('"') + " = "+field.FieldName.Trim('"').ToLower() + ", ";
					//primarykeyParam += GetDataType(field)+ " " + field.FieldName.Trim('"').ToLower() + ", ";
					 
				}
			}
			if( field.FieldName.ToString().Trim('"') == "Tenant")
			{
				 hasTenant = true;
			}
		 }
		 string tenantParamValue="";
		 string tenantParam ="";
		 string tenantCondition = "";
		 string tenantKeyCondition = "";
		 string getalltenantCondition = "";
		 if(hasTenant)
         {
			 tenantParam = ", int tenant";
			 tenantCondition = "&& a.Tenant == tenant";
			 getalltenantCondition = "\n                   where a.Tenant == tenant";

		     tenantKeyCondition = "&& a.Tenant == keys.Tenant";
			 tenantParamValue=",tenant";
         }
	string parententity = "object";
	string parentKeys = tableName + "Keys";
	if(entity.ParentTableName.GetType() == typeof(string))
    {
		parententity = entity.ParentTableName +"PM";
		parentKeys =entity.ParentTableName + "Keys";
    }

    string listName = tableName + "List";
	string keysName = tableName+"Keys";
	#>
