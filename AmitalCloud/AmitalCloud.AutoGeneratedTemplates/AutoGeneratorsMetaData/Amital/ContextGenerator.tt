public void GenerateIContext(string sourceFolder,string destinationFolder,string contextname)
{
    filename = contextname.Replace(".", "");
    isPartial = false;
    if (contextname.Contains("."))
    {
        contextname = contextname.Split('.')[0];
        isPartial = true;
    }
 contextnamespacestring = GetContextNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);
string pocosspacestring = contextnamespacestring.ToString().Substring(0,contextnamespacestring.ToString().LastIndexOf('.')) + ".Data.EntityMapping;";
string dataprojectnamespace = contextnamespacestring.ToString().Substring(0,contextnamespacestring.ToString().LastIndexOf('.')) + ".Data;";
string mappingsspacestring = contextnamespacestring.ToString().Substring(0,contextnamespacestring.ToString().LastIndexOf('.')) + ".Data.EntityPOCOs;";

