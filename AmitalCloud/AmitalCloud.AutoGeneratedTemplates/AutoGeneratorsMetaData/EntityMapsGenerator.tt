<#+		

private string GetEntityMapPropertyName(dynamic property)
{
	return property.ToString().Trim('"') as string;
}

#>

<#+

  private string GetEntityMapDataType(dynamic field)
        {
			
			string typecode = field.FieldsDataType.ToString().Trim('"') as string;
			string result = "string";
            if (typecode == "Boolean")
            {
                result = "bool";
            }
            if (typecode == "Integer" || typecode == "UnsInteger")
            {
                result = "int";
            }

            if (typecode == "Date" || typecode == "DateTime" || typecode == "DateTime2")
            {
                result = "DateTime";
            }

            if (typecode == "Double" || typecode == "SigDouble")
            {
                result = "double";
            }

			 if (typecode == "Decimal" || typecode == "UnsDecimal")
            {
                result = "decimal";
            }
			if(typecode == "List")
            {
				result = typecode;
            }

            
          string isNullable = field.IsNullable as string;
		  if(isNullable == "true" && result != "string")
		  {
			  result = result + "?";
          }

		  return result;

        }
#>
<#+
//Create an elastic object
private dynamic FromEntityMapFile(string file)
{
   var path= Host.ResolvePath(file);
   return XDocument.Load(path).Root.ToElastic();
}

#>