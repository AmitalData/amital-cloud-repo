<#+

dynamic entitymapnamespacestring;
 
public void GenerateAllEntityMaps(string sourceFolder,string destinationFolder)
{
	 

 entitymapnamespacestring = GetEntityMapNameSpace(destinationFolder);
 string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
 string sourceFilePath = Path.Combine(templateDirectory, sourceFolder);

foreach (string file in Directory.EnumerateFiles(sourceFilePath, "*.lxml"))
{

    var fileNameWithoutExtension = Path.GetFileNameWithoutExtension(file);
	GenerateEntityMap(file,destinationFolder+"/"+fileNameWithoutExtension+"Map.cs");
}

 
}
#>



<#+  

public void GenerateEntityMap(string xmlFilePath,string outputFilePath)
{
	
	 
	if(string.IsNullOrEmpty(entitymapnamespacestring))
    {
		entitymapnamespacestring = GetEntityMapNameSpace(outputFilePath);
    }
    var entity = FromEntityMapFile(xmlFilePath);
		 if( entity.IsMetadataOnlyTable.GetType() == typeof(string))
      	{
	    	if(entity.IsMetadataOnlyTable == "true")
	    	{
	    		return;
	    	}
	    } 
    WriteEntityMapMethod(entity);
    SaveEntityMapOutput(outputFilePath);
    
}
 
#>


<#+

public dynamic GetEntityMapNameSpace(string destinationFolder)
{
	string spacestring = "";
	string[] path = destinationFolder.Split('/');
	foreach(string dir in path)
    {
		if(dir != "..")
        {
			spacestring += dir + ".";
        }
    }

	
	spacestring = spacestring.ToString().Trim('.');
 
	return spacestring;
}

#>

<#+
void SaveEntityMapOutput(string outputFileName)
  {
      string templateDirectory = Path.GetDirectoryName(Host.TemplateFile);
      string outputFilePath = Path.Combine(templateDirectory, outputFileName);
	

	   var manager = Manager.Create(Host, GenerationEnvironment);
	  manager.CreateTestFile(outputFilePath,this.GenerationEnvironment.ToString().Trim('\n'));
	  this.GenerationEnvironment.Remove(0, this.GenerationEnvironment.Length);
  }
#>


