<#+

private string BuildEntityMapString(dynamic field)
{
	
	dynamic fieldName = GetEntityMapPropertyName(field.FieldName);
	string datatype = GetEntityMapPropertyName(field.FieldsDataType.ToString());

	string mapstring =  "";

if( field.IsPrimaryKey.GetType() == typeof(string))
{
if(field.IsPrimaryKey.ToString() == "true")
{
           
     

}
}
else
{
#>
   
<#+
}

if( field.IsForeignKey.GetType() == typeof(string))
{
if(field.IsForeignKey == "true")
{
 
 
}
}
if( field.IsRequired.GetType() == typeof(string))
{
	string isRequired = field.IsRequired;
	if(isRequired == "true")
    {
      mapstring += ".IsRequired()";
    }
}
	

	if(datatype == "Text" || datatype == "nText" || datatype == "LookUp" || datatype == "Emails")
    {
	   string isMaxLength = "false";
	if( field.IsMaxLength.GetType() == typeof(string))
	{
	  isMaxLength = field.IsMaxLength;
	}
	
	 int maxLengthNumber = int.Parse(field.MaxLength.ToString());
 
	if(isMaxLength == "true")
	{
       mapstring += ".IsMaxLength()";
	}
		else
    {
		if(datatype == "nText" && maxLengthNumber > 2000)
        {
#>

            dbms = System.Configuration.ConfigurationManager.AppSettings.Get("DBMS");
            if (dbms == "oracle")
            {
              this.Property(t => t.<#= fieldName #>).HasMaxLength(2000);
			}
            else
            {
              this.Property(t => t.<#= fieldName #>).HasMaxLength(<#= field.MaxLength #>);
			}

<#+
        }
		else
        {
		if(field.MinLength.GetType() == typeof(string))
        {
              mapstring += ".HasMaxLength("+field.MaxLength + ")";
        }
		else
        {

			mapstring += ".HasMaxLength("+field.MaxLength + ")";
 
       }
      }
		
	}
    }
	 
 string foreingnentityname =GetEntityMapPropertyName(field.ForeignEntity);
	
	string typeName = null;
	switch (datatype)
    {
		case "Text":
	    case "Emails":
		case "LookUp":
        {
			 string isFixedLength = "false";
	if( field.IsFixedLength.GetType() == typeof(string))
	{
	  isFixedLength = field.IsFixedLength;
	}
			//if(foreingnentityname == "TransportMode" || foreingnentityname == "Direction")
			if(isFixedLength=="true")
            {
				typeName = "char";
				mapstring += ".IsFixedLength()";
            }
			else
            {
				mapstring += ".IsUnicode(false)";
              typeName = "varchar";
            }
			break;
        }
			case "nText":
        {
			 typeName = "nvarchar";
			 mapstring += ".IsUnicode(true)";
			break;
        }
		case "Integer":
			if(field.IsPrimaryKey.ToString() == "true")
			{
				 mapstring += ".HasDatabaseGeneratedOption(null)";
			}
			break;

			case "Decimal":
			if( field.NumberOfDigits.GetType() == typeof(string) && field.DigitsAfterPoint.GetType() == typeof(string))
	        {
				mapstring += ".HasPrecision("+field.NumberOfDigits +", "+ field.DigitsAfterPoint +")";
            }
			   //HasPrecision(16, 2);
			break;
    }

	if(!string.IsNullOrEmpty(typeName))
    {
		 
    }
	else
    {
		 
    }
 
	return mapstring;
  }

 
 

